    </units>
    <units name="microL">
        <unit prefix="micro" units="litre"/>
    </units>
    <units name="picoFarad">
        <unit prefix="pico" units="farad"/>
    </units>
    <units name="cm3_per_second">
        <unit exponent="3" prefix="centi" units="meter"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="um3_per_second">
        <unit exponent="3" prefix="micro" units="meter"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="m3mM">
        <unit exponent="3" units="meter"/>
        <unit exponent="1" units="mM"/>
    </units>
    <units name="ms2">
        <unit exponent="2" units="ms"/>
    </units>
    <units name="nM3_per_ps">
        <unit exponent="3" prefix="nano" units="meter"/>
        <unit exponent="-1" prefix="pico" units="second"/>
    </units>
    <units name="per_s_squared_m_cubed">
        <unit exponent="-2" units="second"/>
        <unit exponent="-3" units="meter"/>
    </units>
    <units name="per_meters_cubed">
        <unit exponent="-3" units="meter"/>
    </units>
    <units name="umeter3">
        <unit exponent="3" prefix="micro" units="meter"/>
    </units>
    <units name="mill1">
        <unit exponent="-1" units="volt"/>
        <unit prefix="milli" units="volt"/>
    </units>
    <units name="picoV">
        <unit prefix="pico" units="volt"/>
    </units>
    <units name="pic0">
        <unit exponent="-1" units="volt"/>
        <unit units="picoV"/>
    </units>
    <units name="nanoV">
        <unit prefix="nano" units="volt"/>
    </units>
    <units name="nan0">
        <unit exponent="-1" units="volt"/>
        <unit units="nanoV"/>
    </units>
    <units name="kPa">
        <unit prefix="kilo" units="pascal"/>
    </units>
    <units name="L_per_s">
        <!--unit litre;-->
        <unit exponent="3" prefix="deci" units="meter"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="L_per_s_per_kPa">
        <!--unit litre;-->
        <unit exponent="3" prefix="deci" units="meter"/>
        <unit exponent="-1" units="second"/>
        <unit exponent="-1" prefix="kilo" units="pascal"/>
    </units>
    <units name="kPa_per_L">
        <unit prefix="kilo" units="pascal"/>
        <!--unit litre {expo: -1};-->
        <unit exponent="-3" prefix="deci" units="meter"/>
    </units>
    <units name="L_per_kPa">
        <!--unit litre;-->
        <unit exponent="3" prefix="deci" units="meter"/>
        <unit exponent="-1" prefix="kilo" units="pascal"/>
    </units>
    <units name="kPa_s_per_L">
        <unit prefix="kilo" units="pascal"/>
        <unit units="second"/>
        <!--unit litre {expo: -1};-->
        <unit exponent="-3" prefix="deci" units="meter"/>
    </units>
    <!--&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;imports&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;//-->
    <!-- inlined from switching_test_modules.cellml -->
    <component name="inlet_module">
        <!--import variables-->
        <variable name="t" public_interface="in" units="second"/>
        <variable name="H_global_L" public_interface="in" units="dimensionless"/>
        <variable name="H_global_R" public_interface="in" units="dimensionless"/>
        <variable name="H_L_out_RHS" public_interface="in" units="dimensionless"/>
        <variable name="H_R_out_LHS" public_interface="in" units="dimensionless"/>
        <variable name="gamma_mirror" public_interface="in" units="dimensionless"/>
        <variable name="tau_H_down" public_interface="in" units="second"/>
        <variable name="tau_H_mean" public_interface="in" units="second"/>
        <!--0.001-->
        <variable name="v_eps" public_interface="in" units="m3_per_s"/>
        <variable name="q_C_init" public_interface="in" units="m3"/>
        <!--0-->
        <variable name="l" public_interface="in" units="metre"/>
        <variable name="r" public_interface="in" units="metre"/>
        <variable name="mu_plasma" public_interface="in" units="Js_per_m3"/>
        <variable name="u_in" public_interface="in" units="J_per_m3"/>
        <variable name="u_ext" public_interface="in" units="J_per_m3"/>
        <variable name="u_out" public_interface="in" units="J_per_m3"/>
        <variable name="tau_link" public_interface="in" units="second"/>
        <variable name="v_scale" public_interface="in" units="m3_per_s"/>
        <variable name="one_mm3" public_interface="in" units="m3"/>
        <variable name="w_v" public_interface="out" units="dimensionless"/>
        <variable name="w_v_d" public_interface="out" units="dimensionless"/>
        <!--w_v   = 0.5{dimensionless}+1{dimensionless}/pi*atan(v/v_scale);-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_v</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>v</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <piece>
                        <cn cellml:units="dimensionless">0</cn>
                        <apply>
                            <lt/>
                            <ci>v</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0.5</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <!--w_v_d = 0.5{dimensionless}+1{dimensionless}/pi*atan(v_d/v_scale);-->
            <apply>
                <eq/>
                <ci>w_v_d</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>v_d</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <piece>
                        <cn cellml:units="dimensionless">0</cn>
                        <apply>
                            <lt/>
                            <ci>v_d</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0.5</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!--/////////////////////////coupling with RHS vessel using ode to break 
instaneous coupling requirement/////////-->
        <variable name="H_link_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_R</ci>
                <ci>H_L_out_RHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_link_L" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_L</ci>
                <ci>H_R_out_LHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_L_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_in</ci>
                <ci>H_link_L</ci>
            </apply>
        </math>
        <variable name="H_R_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_R_in</ci>
                <ci>H_link_R</ci>
            </apply>
        </math>
        <variable name="H_up" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_up</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v_d</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v_d</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="0.449999999836463" name="H_down" public_interface="out" units="dimensionless"/>
        <variable name="H_down_target" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_down_target</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>s_v_d</ci>
                        <apply>
                            <plus/>
                            <ci>H_mean</ci>
                            <apply>
                                <times/>
                                <ci>gamma_mirror</ci>
                                <apply>
                                    <minus/>
                                    <ci>H_mean</ci>
                                    <ci>H_up</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>s_v_d</ci>
                        </apply>
                        <ci>H_mean</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>H_down</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>H_down_target</ci>
                        <ci>H_down</ci>
                    </apply>
                    <ci>tau_H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="s_v_d" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>s_v_d</ci>
                <apply>
                    <divide/>
                    <apply>
                        <abs/>
                        <ci>v_d</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <abs/>
                            <ci>v_d</ci>
                        </apply>
                        <ci>v_eps</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--/useful when flow =0, if 0, make H_down=H_mean-->
        <variable name="H_L_out" public_interface="out" units="dimensionless"/>
        <variable name="H_R_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_out</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>w_v_d</ci>
                    </apply>
                    <ci>H_down</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_R_out</ci>
                <apply>
                    <times/>
                    <ci>w_v_d</ci>
                    <ci>H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="v_RBC" public_interface="out" units="m3_per_s"/>
        <variable name="v_d_RBC" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.37</cn>
                    <ci>v</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_d_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.37</cn>
                    <ci>v_d</ci>
                </apply>
            </apply>
        </math>
        <variable initial_value="1.52695561386807e-14" name="RBC_volume" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RBC_volume</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>v_RBC</ci>
                        <ci>RBC_volume_L</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>v_d_RBC</ci>
                        <ci>RBC_volume_R</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="RBC_volume_init" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_init</ci>
                <apply>
                    <times/>
                    <ci>H_global_L</ci>
                    <ci>q_us</ci>
                </apply>
            </apply>
            <!--pos/neg for RBC mass conservation only-->
            <!-- inflow from right (v_d<0)-->
            <!--var H_target: dimensionless {pub: out};-->
            <!--H_target = RBC_volume/q;-->
            <apply>
                <eq/>
                <ci>H_mean</ci>
                <apply>
                    <divide/>
                    <ci>RBC_volume</ci>
                    <ci>q</ci>
                </apply>
            </apply>
        </math>
        <variable name="H_mean" public_interface="out" units="dimensionless"/>
        <!--ode(H_mean, t) = (H_target-H_mean)/tau_H_mean;-->
        <variable name="RBC_volume_L" public_interface="out" units="dimensionless"/>
        <variable name="RBC_volume_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_L</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_L_out</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>RBC_volume_R</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v_d</ci>
                        <ci>H_R_out</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v_d</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--//////////////-->
        <variable initial_value="3.14632811845253e-18" name="q_C" public_interface="out" units="m3"/>
        <variable name="q" public_interface="out" units="m3"/>
        <variable name="q_us" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q_us</ci>
                <apply>
                    <times/>
                    <pi/>
                    <apply>
                        <power/>
                        <ci>r</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <ci>l</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q</ci>
                <apply>
                    <plus/>
                    <ci>q_us</ci>
                    <ci>q_C</ci>
                </apply>
            </apply>
        </math>
        <variable name="C" public_interface="out" units="m6_per_J"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>C</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <cn cellml:units="metre" type="e-notation">8.5<sep/>-9</cn>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                        <ci>l</ci>
                    </apply>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
        </math>
        <variable name="Z" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Z</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">0.8</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">0.075</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <divide/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <power/>
                                            <cn cellml:units="dimensionless">10</cn>
                                            <apply>
                                                <minus/>
                                                <cn cellml:units="dimensionless">11</cn>
                                            </apply>
                                        </apply>
                                        <apply>
                                            <power/>
                                            <apply>
                                                <times/>
                                                <cn cellml:units="dimensionless">2</cn>
                                                <ci>r</ci>
                                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                            </apply>
                                            <cn cellml:units="dimensionless">12</cn>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <cn cellml:units="dimensionless">10</cn>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">11</cn>
                                    </apply>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">12</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu_45" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu_45</ci>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">6</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="per_m">0.085</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">3.2</cn>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.44</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">0.06</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="per_m">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">0.645</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu" public_interface="out" units="Js_per_m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu</ci>
                <apply>
                    <times/>
                    <ci>hem_dep_u_rel</ci>
                    <ci>mu_plasma</ci>
                </apply>
            </apply>
        </math>
        <variable name="hem_dep_u_rel" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>hem_dep_u_rel</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <ci>mu_45</ci>
                                    <cn cellml:units="dimensionless">1</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <power/>
                                        <apply>
                                            <minus/>
                                            <cn cellml:units="dimensionless">1</cn>
                                            <ci>H_mean</ci>
                                        </apply>
                                        <ci>Z</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">1</cn>
                                </apply>
                            </apply>
                            <apply>
                                <minus/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">1</cn>
                                        <ci>H_global_L</ci>
                                    </apply>
                                    <ci>Z</ci>
                                </apply>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                        </apply>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="metre">1.1</cn>
                                </apply>
                            </apply>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="R" public_interface="out" units="Js_per_m6"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">8</cn>
                        <ci>mu</ci>
                        <ci>l</ci>
                    </apply>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <ci>r</ci>
                            <cn cellml:units="dimensionless">4</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="v" public_interface="out" units="m3_per_s"/>
        <variable name="v_mm3_s" public_interface="out" units="mm3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_mm3_s</ci>
                <apply>
                    <divide/>
                    <ci>v</ci>
                    <ci>one_mm3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_in</ci>
                        <ci>u</ci>
                    </apply>
                    <apply>
                        <divide/>
                        <ci>R</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="u" public_interface="out" units="J_per_m3"/>
        <variable name="u_mmHg" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>u_mmHg</ci>
                <apply>
                    <divide/>
                    <ci>u</ci>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <ci>q_C</ci>
                        <ci>C</ci>
                    </apply>
                    <ci>u_ext</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_C</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v</ci>
                    <ci>v_d</ci>
                </apply>
            </apply>
        </math>
        <variable name="v_d" public_interface="out" units="m3_per_s"/>
        <variable name="v_d_mm3_s" public_interface="out" units="mm3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_d_mm3_s</ci>
                <apply>
                    <divide/>
                    <ci>v_d</ci>
                    <ci>one_mm3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_d</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u</ci>
                        <ci>u_out</ci>
                    </apply>
                    <apply>
                        <divide/>
                        <ci>R</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <!-- inlined from switching_test_modules.cellml -->
    <component name="VV_junc1_module">
        <variable name="div_0" public_interface="in" units="dimensionless"/>
        <variable name="div_0y" public_interface="in" units="dimensionless"/>
        <variable name="v_threshold" public_interface="in" units="m3_per_s"/>
        <variable name="k" public_interface="in" units="dimensionless"/>
        <variable name="t" public_interface="in" units="second"/>
        <variable name="H_global_L" public_interface="in" units="dimensionless"/>
        <variable name="H_global_R" public_interface="in" units="dimensionless"/>
        <variable name="q_C_init" public_interface="in" units="m3"/>
        <variable name="l" public_interface="in" units="metre"/>
        <variable name="r" public_interface="in" units="metre"/>
        <variable name="mu_plasma" public_interface="in" units="Js_per_m3"/>
        <variable name="u_ext" public_interface="in" units="J_per_m3"/>
        <variable name="v_scale" public_interface="in" units="m3_per_s"/>
        <variable name="one_mm3" public_interface="in" units="m3"/>
        <!--///////////////////////vessel mapping coupling module/////////////////////-->
        <variable name="vbc1" public_interface="in" units="m3_per_s"/>
        <variable name="vbc2" public_interface="in" units="m3_per_s"/>
        <variable name="vbc3" public_interface="in" units="m3_per_s"/>
        <variable name="vbc4" public_interface="in" units="m3_per_s"/>
        <variable name="vj1" public_interface="out" units="m3_per_s"/>
        <variable name="vj2" public_interface="out" units="m3_per_s"/>
        <variable name="vj3" public_interface="out" units="m3_per_s"/>
        <variable name="vj4" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>vj1</ci>
                <ci>vbc1</ci>
            </apply>
            <apply>
                <eq/>
                <ci>vj2</ci>
                <ci>vbc2</ci>
            </apply>
            <apply>
                <eq/>
                <ci>vj3</ci>
                <apply>
                    <minus/>
                    <ci>vbc3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>vj4</ci>
                <apply>
                    <minus/>
                    <ci>vbc4</ci>
                </apply>
            </apply>
        </math>
        <!--////////////Hematocrit to port (vessel to junction) mapping////////////-->
        <variable name="H_to1" public_interface="in" units="dimensionless"/>
        <variable name="H_to2" public_interface="in" units="dimensionless"/>
        <variable name="H_to3" public_interface="in" units="dimensionless"/>
        <variable name="H_to4" public_interface="in" units="dimensionless"/>
        <!-- EXAMPLES -->
        <variable name="H_split1" public_interface="out" units="dimensionless"/>
        <variable name="H_split2" public_interface="out" units="dimensionless"/>
        <variable name="H_split3" public_interface="out" units="dimensionless"/>
        <variable name="H_split4" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_split1</ci>
                <piecewise>
                    <piece>
                        <ci>H_VV_out_alpha</ci>
                        <apply>
                            <eq/>
                            <ci>alpha1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>H_VV_out_beta</ci>
                        <apply>
                            <eq/>
                            <ci>beta1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to1</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <!-- not a split-daughter => unchanged-->
            <apply>
                <eq/>
                <ci>H_split2</ci>
                <piecewise>
                    <piece>
                        <ci>H_VV_out_alpha</ci>
                        <apply>
                            <eq/>
                            <ci>alpha2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>H_VV_out_beta</ci>
                        <apply>
                            <eq/>
                            <ci>beta2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to2</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>H_split3</ci>
                <piecewise>
                    <piece>
                        <ci>H_VV_out_alpha</ci>
                        <apply>
                            <eq/>
                            <ci>alpha3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>H_VV_out_beta</ci>
                        <apply>
                            <eq/>
                            <ci>beta3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to3</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>H_split4</ci>
                <piecewise>
                    <piece>
                        <ci>H_VV_out_alpha</ci>
                        <apply>
                            <eq/>
                            <ci>alpha4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>H_VV_out_beta</ci>
                        <apply>
                            <eq/>
                            <ci>beta4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to4</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="H_daughter1" public_interface="out" units="dimensionless"/>
        <variable name="H_daughter2" public_interface="out" units="dimensionless"/>
        <variable name="H_daughter3" public_interface="out" units="dimensionless"/>
        <variable name="H_daughter4" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_daughter1</ci>
                <piecewise>
                    <piece>
                        <ci>H_mean</ci>
                        <apply>
                            <eq/>
                            <ci>is_merge</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>H_split1</ci>
                        <apply>
                            <eq/>
                            <ci>is_split</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to1</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>H_daughter2</ci>
                <piecewise>
                    <piece>
                        <ci>H_mean</ci>
                        <apply>
                            <eq/>
                            <ci>is_merge</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>H_split2</ci>
                        <apply>
                            <eq/>
                            <ci>is_split</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to2</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>H_daughter3</ci>
                <piecewise>
                    <piece>
                        <ci>H_mean</ci>
                        <apply>
                            <eq/>
                            <ci>is_merge</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>H_split3</ci>
                        <apply>
                            <eq/>
                            <ci>is_split</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to3</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>H_daughter4</ci>
                <piecewise>
                    <piece>
                        <ci>H_mean</ci>
                        <apply>
                            <eq/>
                            <ci>is_merge</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>H_split4</ci>
                        <apply>
                            <eq/>
                            <ci>is_split</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to4</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; H_from*_target: if daughter -> H_daughter*, else unchanged &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="H_from1_target" public_interface="out" units="dimensionless"/>
        <variable name="H_from2_target" public_interface="out" units="dimensionless"/>
        <variable name="H_from3_target" public_interface="out" units="dimensionless"/>
        <variable name="H_from4_target" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_from1_target</ci>
                <piecewise>
                    <piece>
                        <ci>H_daughter1</ci>
                        <apply>
                            <eq/>
                            <ci>bc1_is_out</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to1</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>H_from2_target</ci>
                <piecewise>
                    <piece>
                        <ci>H_daughter2</ci>
                        <apply>
                            <eq/>
                            <ci>bc2_is_out</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to2</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>H_from3_target</ci>
                <piecewise>
                    <piece>
                        <ci>H_daughter3</ci>
                        <apply>
                            <eq/>
                            <ci>bc3_is_out</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to3</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>H_from4_target</ci>
                <piecewise>
                    <piece>
                        <ci>H_daughter4</ci>
                        <apply>
                            <eq/>
                            <ci>bc4_is_out</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>H_to4</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="H_from1" public_interface="out" units="dimensionless"/>
        <variable name="H_from2" public_interface="out" units="dimensionless"/>
        <variable name="H_from3" public_interface="out" units="dimensionless"/>
        <variable name="H_from4" public_interface="out" units="dimensionless"/>
        <!-- When w_out ~ 0 (not a daughter), derivative ~0 => holds last daughter value.-->
        <!--ode(H_from1, t) = w_out1*(H_from1_target-H_from1)/tau_junc;-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_from1</ci>
                <apply>
                    <times/>
                    <ci>w_out1</ci>
                    <ci>H_from1_target</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_from2</ci>
                <apply>
                    <times/>
                    <ci>w_out2</ci>
                    <ci>H_from2_target</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_from3</ci>
                <apply>
                    <times/>
                    <ci>w_out3</ci>
                    <ci>H_from3_target</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_from4</ci>
                <apply>
                    <times/>
                    <ci>w_out4</ci>
                    <ci>H_from4_target</ci>
                </apply>
            </apply>
        </math>
        <!--ode(H_from2, t) = w_out2*(H_from2_target-H_from2)/tau_junc;
ode(H_from3, t) = w_out3*(H_from3_target-H_from3)/tau_junc;
ode(H_from4, t) = w_out4*(H_from4_target-H_from4)/tau_junc;-->
        <variable name="r_bc1" public_interface="in" units="metre"/>
        <!-- diameter of vessel at port 1 (junction side)-->
        <variable name="r_bc2" public_interface="in" units="metre"/>
        <!-- diameter of vessel at port 2-->
        <variable name="r_bc3" public_interface="in" units="metre"/>
        <!-- diameter of vessel at port 3-->
        <variable name="r_bc4" public_interface="in" units="metre"/>
        <variable name="D1" public_interface="out" units="metre"/>
        <!-- diameter of vessel at port 1 (junction side)-->
        <variable name="D2" public_interface="out" units="metre"/>
        <!-- diameter of vessel at port 2-->
        <variable name="D3" public_interface="out" units="metre"/>
        <!-- diameter of vessel at port 3-->
        <variable name="D4" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>D1</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r_bc1</ci>
                </apply>
            </apply>
            <!-- <&#45;&#45; port1 attached vessel diameter (example: parent VV side)-->
            <apply>
                <eq/>
                <ci>D2</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r_bc2</ci>
                </apply>
            </apply>
            <!-- <&#45;&#45; port2 (if unused, still define)-->
            <apply>
                <eq/>
                <ci>D3</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r_bc3</ci>
                </apply>
            </apply>
            <!-- <&#45;&#45; port3 daughter candidate-->
            <apply>
                <eq/>
                <ci>D4</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r_bc4</ci>
                </apply>
            </apply>
        </math>
        <variable name="w_in1" public_interface="out" units="dimensionless"/>
        <variable name="w_in2" public_interface="out" units="dimensionless"/>
        <variable name="w_in3" public_interface="out" units="dimensionless"/>
        <variable name="w_in4" public_interface="out" units="dimensionless"/>
        <!--1 when vj is positive, 0 when vj is 0-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_in1</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>vj1</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_in2</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>vj2</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_in3</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>vj3</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_in4</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>vj4</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="w_out1" public_interface="out" units="dimensionless"/>
        <variable name="w_out2" public_interface="out" units="dimensionless"/>
        <variable name="w_out3" public_interface="out" units="dimensionless"/>
        <variable name="w_out4" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_out1</ci>
                <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>w_in1</ci>
                </apply>
            </apply>
            <!-- ~1 if vj1<0-->
            <apply>
                <eq/>
                <ci>w_out2</ci>
                <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>w_in2</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_out3</ci>
                <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>w_in3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_out4</ci>
                <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>w_in4</ci>
                </apply>
            </apply>
        </math>
        <variable name="Qin1" public_interface="out" units="m3_per_s"/>
        <variable name="Qin2" public_interface="out" units="m3_per_s"/>
        <variable name="Qin3" public_interface="out" units="m3_per_s"/>
        <variable name="Qin4" public_interface="out" units="m3_per_s"/>
        <variable name="Qout1" public_interface="out" units="m3_per_s"/>
        <variable name="Qout2" public_interface="out" units="m3_per_s"/>
        <variable name="Qout3" public_interface="out" units="m3_per_s"/>
        <variable name="Qout4" public_interface="out" units="m3_per_s"/>
        <!--absolute flow into the junction-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Qin1</ci>
                <apply>
                    <times/>
                    <ci>w_in1</ci>
                    <ci>vj1</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qin2</ci>
                <apply>
                    <times/>
                    <ci>w_in2</ci>
                    <ci>vj2</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qin3</ci>
                <apply>
                    <times/>
                    <ci>w_in3</ci>
                    <ci>vj3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qin4</ci>
                <apply>
                    <times/>
                    <ci>w_in4</ci>
                    <ci>vj4</ci>
                </apply>
            </apply>
            <!--absolute (magnitude) of flow out of the junction-->
            <apply>
                <eq/>
                <ci>Qout1</ci>
                <apply>
                    <times/>
                    <ci>w_out1</ci>
                    <apply>
                        <minus/>
                        <ci>vj1</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qout2</ci>
                <apply>
                    <times/>
                    <ci>w_out2</ci>
                    <apply>
                        <minus/>
                        <ci>vj2</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qout3</ci>
                <apply>
                    <times/>
                    <ci>w_out3</ci>
                    <apply>
                        <minus/>
                        <ci>vj3</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qout4</ci>
                <apply>
                    <times/>
                    <ci>w_out4</ci>
                    <apply>
                        <minus/>
                        <ci>vj4</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="Qin_tot" public_interface="out" units="m3_per_s"/>
        <variable name="Qout_tot" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Qin_tot</ci>
                <apply>
                    <plus/>
                    <ci>Qin1</ci>
                    <ci>Qin2</ci>
                    <ci>Qin3</ci>
                    <ci>Qin4</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qout_tot</ci>
                <apply>
                    <plus/>
                    <ci>Qout1</ci>
                    <ci>Qout2</ci>
                    <ci>Qout3</ci>
                    <ci>Qout4</ci>
                </apply>
            </apply>
        </math>
        <variable name="bc1_is_in" public_interface="out" units="dimensionless"/>
        <variable name="bc2_is_in" public_interface="out" units="dimensionless"/>
        <variable name="bc3_is_in" public_interface="out" units="dimensionless"/>
        <variable name="bc4_is_in" public_interface="out" units="dimensionless"/>
        <variable name="bc1_is_out" public_interface="out" units="dimensionless"/>
        <variable name="bc2_is_out" public_interface="out" units="dimensionless"/>
        <variable name="bc3_is_out" public_interface="out" units="dimensionless"/>
        <variable name="bc4_is_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>bc1_is_in</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qin1</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc2_is_in</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qin2</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc3_is_in</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qin3</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc4_is_in</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qin4</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc1_is_out</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qout1</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc2_is_out</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qout2</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc3_is_out</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qout3</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc4_is_out</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qout4</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="n_in" public_interface="out" units="dimensionless"/>
        <variable name="n_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>n_in</ci>
                <apply>
                    <plus/>
                    <ci>bc1_is_in</ci>
                    <ci>bc2_is_in</ci>
                    <ci>bc3_is_in</ci>
                    <ci>bc4_is_in</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>n_out</ci>
                <apply>
                    <plus/>
                    <ci>bc1_is_out</ci>
                    <ci>bc2_is_out</ci>
                    <ci>bc3_is_out</ci>
                    <ci>bc4_is_out</ci>
                </apply>
            </apply>
        </math>
        <!-- junction_type: +1 split (1 feeder), -1 merge (>=2 feeders), 0 other/degenerate-->
        <variable name="junction_type" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>junction_type</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <eq/>
                            <ci>n_in</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                        <apply>
                            <geq/>
                            <ci>n_in</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;- junction mode flags derived from your junction_type &#45;&#45;- -->
        <variable name="is_split" public_interface="out" units="dimensionless"/>
        <variable name="is_merge" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>is_split</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <eq/>
                            <ci>junction_type</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>is_merge</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <eq/>
                            <ci>junction_type</ci>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; pick FEED port in split: the largest Qin (ties broken 1->2->3->4) &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="feed1" public_interface="out" units="dimensionless"/>
        <variable name="feed2" public_interface="out" units="dimensionless"/>
        <variable name="feed3" public_interface="out" units="dimensionless"/>
        <variable name="feed4" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>feed1</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin1</ci>
                                <ci>Qin2</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin1</ci>
                                <ci>Qin3</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin1</ci>
                                <ci>Qin4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>feed2</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin2</ci>
                                <ci>Qin1</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin2</ci>
                                <ci>Qin3</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin2</ci>
                                <ci>Qin4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>feed3</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin3</ci>
                                <ci>Qin1</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin3</ci>
                                <ci>Qin2</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin3</ci>
                                <ci>Qin4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>feed4</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin4</ci>
                                <ci>Qin1</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin4</ci>
                                <ci>Qin2</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin4</ci>
                                <ci>Qin3</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; alpha = daughter port with biggest Qout (ties 1->2->3->4) &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="alpha1" public_interface="out" units="dimensionless"/>
        <variable name="alpha2" public_interface="out" units="dimensionless"/>
        <variable name="alpha3" public_interface="out" units="dimensionless"/>
        <variable name="alpha4" public_interface="out" units="dimensionless"/>
        <!-- alpha1 if port1 is a daughter AND has >= Qout than others-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>alpha1</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc1_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout1</ci>
                                <ci>Qout2</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout1</ci>
                                <ci>Qout3</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout1</ci>
                                <ci>Qout4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <!-- alpha2 only if not alpha1 (tie-break) and port2 is a daughter and beats remaining-->
            <apply>
                <eq/>
                <ci>alpha2</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc2_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout2</ci>
                                <ci>Qout1</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout2</ci>
                                <ci>Qout3</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout2</ci>
                                <ci>Qout4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>alpha3</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc3_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout3</ci>
                                <ci>Qout1</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout3</ci>
                                <ci>Qout2</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout3</ci>
                                <ci>Qout4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>alpha4</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc4_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout4</ci>
                                <ci>Qout1</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout4</ci>
                                <ci>Qout2</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout4</ci>
                                <ci>Qout3</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="beta1" public_interface="out" units="dimensionless"/>
        <variable name="beta2" public_interface="out" units="dimensionless"/>
        <variable name="beta3" public_interface="out" units="dimensionless"/>
        <variable name="beta4" public_interface="out" units="dimensionless"/>
        <!-- beta among remaining daughters (ties 1->2->3->4), must be a daughter-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>beta1</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc1_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>alpha1</ci>
                                <cn cellml:units="dimensionless">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>beta2</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc2_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>alpha2</ci>
                                <cn cellml:units="dimensionless">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>beta3</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc3_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>alpha3</ci>
                                <cn cellml:units="dimensionless">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>beta4</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc4_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>alpha4</ci>
                                <cn cellml:units="dimensionless">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="D_F" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>D_F</ci>
                <piecewise>
                    <piece>
                        <ci>D1</ci>
                        <apply>
                            <eq/>
                            <ci>feed1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D2</ci>
                        <apply>
                            <eq/>
                            <ci>feed2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D3</ci>
                        <apply>
                            <eq/>
                            <ci>feed3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D4</ci>
                        <apply>
                            <eq/>
                            <ci>feed4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>D1</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; D_alpha from which ALPHA port? &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="D_alpha" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>D_alpha</ci>
                <piecewise>
                    <piece>
                        <ci>D1</ci>
                        <apply>
                            <eq/>
                            <ci>alpha1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D2</ci>
                        <apply>
                            <eq/>
                            <ci>alpha2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D3</ci>
                        <apply>
                            <eq/>
                            <ci>alpha3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D4</ci>
                        <apply>
                            <eq/>
                            <ci>alpha4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>D3</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; D_beta from which BETA port? &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="D_beta" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>D_beta</ci>
                <piecewise>
                    <piece>
                        <ci>D1</ci>
                        <apply>
                            <eq/>
                            <ci>beta1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D2</ci>
                        <apply>
                            <eq/>
                            <ci>beta2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D3</ci>
                        <apply>
                            <eq/>
                            <ci>beta3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D4</ci>
                        <apply>
                            <eq/>
                            <ci>beta4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>D4</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; daughter outflow magnitudes for alpha/beta &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="v_alpha" public_interface="out" units="m3_per_s"/>
        <variable name="v_beta" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_alpha</ci>
                <piecewise>
                    <piece>
                        <ci>Qout1</ci>
                        <apply>
                            <eq/>
                            <ci>alpha1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout2</ci>
                        <apply>
                            <eq/>
                            <ci>alpha2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout3</ci>
                        <apply>
                            <eq/>
                            <ci>alpha3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout4</ci>
                        <apply>
                            <eq/>
                            <ci>alpha4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="m3_per_s">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>v_beta</ci>
                <piecewise>
                    <piece>
                        <ci>Qout1</ci>
                        <apply>
                            <eq/>
                            <ci>beta1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout2</ci>
                        <apply>
                            <eq/>
                            <ci>beta2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout3</ci>
                        <apply>
                            <eq/>
                            <ci>beta3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout4</ci>
                        <apply>
                            <eq/>
                            <ci>beta4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="m3_per_s">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="FQB_alpha" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>FQB_alpha</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <ci>v_alpha</ci>
                        <ci>div_0</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>v_alpha</ci>
                        <ci>v_beta</ci>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">2</cn>
                            <ci>div_0</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="FQE_alpha" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>FQE_alpha</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <minus/>
                                <apply>
                                    <plus/>
                                    <ci>A</ci>
                                    <apply>
                                        <times/>
                                        <ci>B</ci>
                                        <ci>ph</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="B" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>B</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">6.98</cn>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                                <ci>H_mean</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>D_F</ci>
                            <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="A" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>A</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">6.96</cn>
                        </apply>
                        <apply>
                            <ln/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>D_alpha</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>D_beta</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>D_F</ci>
                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="X_0" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>X_0</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">0.4</cn>
                    <apply>
                        <times/>
                        <ci>D_F</ci>
                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="ph" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>ph</ci>
                <apply>
                    <ln/>
                    <apply>
                        <divide/>
                        <ci>y</ci>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>y</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="y_raw" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>y_raw</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>FQB_alpha</ci>
                        <ci>X_0</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">2</cn>
                                <ci>X_0</ci>
                            </apply>
                        </apply>
                        <ci>div_0</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="y" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>y</ci>
                <apply>
                    <min/>
                    <apply>
                        <max/>
                        <ci>y_raw</ci>
                        <ci>div_0y</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>div_0y</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--var epsilon_alpha: dimensionless {pub: out};-->
        <!--epsilon_alpha = H_VV_out_alpha-H_mean*FQE_alpha/(FQB_alpha+div_0);-->
        <variable name="H_VV_out_alpha" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_VV_out_alpha</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>H_mean</ci>
                        <ci>FQE_alpha</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>FQB_alpha</ci>
                        <ci>div_0</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--ode(H_VV_out_alpha, t) = is_split*-k*epsilon_alpha;-->
        <variable name="H_VV_out_beta" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_VV_out_beta</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>H_mean</ci>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>FQE_alpha</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>FQB_alpha</ci>
                        </apply>
                        <ci>div_0</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--////////////////////////////////VV_BG////////////////////////////////
////////////////////////////////////////////-->
        <variable name="RBC_in" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_in</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>Qin1</ci>
                        <ci>H_to1</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qin2</ci>
                        <ci>H_to2</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qin3</ci>
                        <ci>H_to3</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qin4</ci>
                        <ci>H_to4</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="RBC_out" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_out</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>Qout1</ci>
                        <ci>H_from1</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qout2</ci>
                        <ci>H_from2</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qout3</ci>
                        <ci>H_from3</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qout4</ci>
                        <ci>H_from4</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- &#45;&#45;- stored RBC volume inside VV1 &#45;&#45;- -->
        <variable name="RBC_volume_init" public_interface="out" units="m3"/>
        <variable initial_value="2.61396215550874e-17" name="RBC_volume" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_init</ci>
                <apply>
                    <times/>
                    <ci>H_global_L</ci>
                    <ci>q_us</ci>
                </apply>
            </apply>
            <!-- mass balance-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RBC_volume</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>RBC_in</ci>
                    <ci>RBC_out</ci>
                </apply>
            </apply>
        </math>
        <!-- &#45;&#45;- mean VV1 hematocrit (concentration) &#45;&#45;- -->
        <variable name="H_mean" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_mean</ci>
                <apply>
                    <divide/>
                    <ci>RBC_volume</ci>
                    <apply>
                        <plus/>
                        <ci>q_us</ci>
                        <ci>div_0</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--/////////////////////////////setting junctional compliance to greatest compliance of the vessels connected to it -->
        <variable name="C_conn1" public_interface="in" units="m6_per_J"/>
        <variable name="C_conn2" public_interface="in" units="m6_per_J"/>
        <variable name="C_conn3" public_interface="in" units="m6_per_J"/>
        <variable name="C_conn4" public_interface="in" units="m6_per_J"/>
        <variable name="C_max12" public_interface="out" units="m6_per_J"/>
        <variable name="C_max123" public_interface="out" units="m6_per_J"/>
        <variable name="C" public_interface="out" units="m6_per_J"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>C_max12</ci>
                <piecewise>
                    <piece>
                        <ci>C_conn1</ci>
                        <apply>
                            <gt/>
                            <ci>C_conn1</ci>
                            <ci>C_conn2</ci>
                        </apply>
                    </piece>
                    <piece>
                        <ci>C_conn2</ci>
                        <apply>
                            <leq/>
                            <ci>C_conn1</ci>
                            <ci>C_conn2</ci>
                        </apply>
                    </piece>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>C_max123</ci>
                <piecewise>
                    <piece>
                        <ci>C_max12</ci>
                        <apply>
                            <gt/>
                            <ci>C_max12</ci>
                            <ci>C_conn3</ci>
                        </apply>
                    </piece>
                    <piece>
                        <ci>C_conn3</ci>
                        <apply>
                            <leq/>
                            <ci>C_max12</ci>
                            <ci>C_conn3</ci>
                        </apply>
                    </piece>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>C</ci>
                <piecewise>
                    <piece>
                        <ci>C_max123</ci>
                        <apply>
                            <gt/>
                            <ci>C_max123</ci>
                            <ci>C_conn4</ci>
                        </apply>
                    </piece>
                    <piece>
                        <ci>C_conn4</ci>
                        <apply>
                            <leq/>
                            <ci>C_max123</ci>
                            <ci>C_conn4</ci>
                        </apply>
                    </piece>
                </piecewise>
            </apply>
        </math>
        <variable initial_value="2.61829632845498e-18" name="q_C" public_interface="out" units="m3"/>
        <variable initial_value="2.61822468856469e-18" name="q_C_d" public_interface="out" units="m3"/>
        <variable name="q" public_interface="out" units="m3"/>
        <variable name="q_us" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q_us</ci>
                <apply>
                    <times/>
                    <pi/>
                    <apply>
                        <power/>
                        <ci>r</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <ci>l</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q</ci>
                <apply>
                    <plus/>
                    <ci>q_us</ci>
                    <ci>q_C</ci>
                    <ci>q_C_d</ci>
                </apply>
            </apply>
        </math>
        <variable name="R_VV_junc" public_interface="in" units="Js_per_m6"/>
        <!-- State Variables-->
        <variable name="u" public_interface="out" units="J_per_m3"/>
        <variable name="u_mmHg" public_interface="out" units="dimensionless"/>
        <variable name="v" public_interface="out" units="m3_per_s"/>
        <variable name="v_mm3_s" public_interface="out" units="mm3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_mm3_s</ci>
                <apply>
                    <divide/>
                    <ci>v</ci>
                    <ci>one_mm3</ci>
                </apply>
            </apply>
        </math>
        <variable name="u_d" public_interface="out" units="J_per_m3"/>
        <variable name="u_d_mmHg" public_interface="out" units="dimensionless"/>
        <!-- Conservation Laws
question?????????? whether ode (q_c and q_C_d) should be vbc1-4 or vj1-4-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>u</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <ci>q_C</ci>
                        <apply>
                            <divide/>
                            <ci>C</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                    <ci>u_ext</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_C</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <ci>vbc1</ci>
                        <ci>vbc2</ci>
                    </apply>
                    <ci>v</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_mmHg</ci>
                <apply>
                    <divide/>
                    <ci>u</ci>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u</ci>
                        <ci>u_d</ci>
                    </apply>
                    <ci>R_VV_junc</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_d</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <ci>q_C_d</ci>
                        <apply>
                            <divide/>
                            <ci>C</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                    <ci>u_ext</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_C_d</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>v</ci>
                        <ci>vbc3</ci>
                    </apply>
                    <ci>vbc4</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_d_mmHg</ci>
                <apply>
                    <divide/>
                    <ci>u_d</ci>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
        </math>
    </component>
    <!-- inlined from switching_test_modules.cellml -->
    <component name="PV1_module">
        <!--import variables-->
        <variable name="v_downstream_RHS" public_interface="in" units="m3_per_s"/>
        <variable name="v_downstream_LHS" public_interface="in" units="m3_per_s"/>
        <variable name="v_downstream" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_downstream</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>v_downstream_RHS</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>v_downstream_LHS</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="tau_sig" public_interface="in" units="second"/>
        <variable name="t0" public_interface="in" units="second"/>
        <variable name="t" public_interface="in" units="second"/>
        <!--var R_constriction_base: Js_per_m6 {pub: in};
var R_constriction_final: Js_per_m6 {pub: in};
var R_constriction: Js_per_m6 {pub: out};-->
        <!--R_constriction = R_constriction_base+(R_constriction_final-R_constriction_base)/(1{dimensionless}+exp(-(t-t0)/tau_sig));-->
        <variable name="H_global_L" public_interface="in" units="dimensionless"/>
        <variable name="H_global_R" public_interface="in" units="dimensionless"/>
        <variable name="H_L_out_RHS" public_interface="in" units="dimensionless"/>
        <variable name="H_R_out_LHS" public_interface="in" units="dimensionless"/>
        <variable name="gamma_mirror" public_interface="in" units="dimensionless"/>
        <variable name="tau_H_down" public_interface="in" units="second"/>
        <variable name="tau_H_mean" public_interface="in" units="second"/>
        <!--0.001-->
        <variable name="v_eps" public_interface="in" units="m3_per_s"/>
        <!--var q_C_init: m3 {pub: in};-->
        <!--0-->
        <variable name="l" public_interface="in" units="metre"/>
        <variable name="r" public_interface="in" units="metre"/>
        <!--var tau_base: second {pub: in};
var gate: dimensionless {pub: out};
var v_base: m3_per_s {init: 0, pub: out};-->
        <!--gate = sel
    case t < t0:
        1{dimensionless};
    otherwise:
        0{dimensionless};
endsel;-->
        <!--ode(v_base, t) = gate*(abs(v)-v_base)/tau_base;-->
        <variable name="mu_plasma" public_interface="in" units="Js_per_m3"/>
        <variable name="u_in" public_interface="in" units="J_per_m3"/>
        <!--var u_ext: J_per_m3 {pub: in};-->
        <variable name="u_out" public_interface="in" units="J_per_m3"/>
        <variable name="tau_link" public_interface="in" units="second"/>
        <variable name="v_scale" public_interface="in" units="m3_per_s"/>
        <variable name="one_mm3" public_interface="in" units="m3"/>
        <variable name="w_v" public_interface="out" units="dimensionless"/>
        <!--var w_v_d: dimensionless {pub: out};-->
        <!--w_v   = 0.5{dimensionless}+1{dimensionless}/pi*atan(v/v_scale);-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_v</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>v</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <piece>
                        <cn cellml:units="dimensionless">0</cn>
                        <apply>
                            <lt/>
                            <ci>v</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0.5</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!--/////compliance kept in new modules for compliance port mapping 
for VV junction compliance determination-->
        <variable name="C" public_interface="out" units="m6_per_J"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>C</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <cn cellml:units="metre" type="e-notation">8.5<sep/>-9</cn>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                        <ci>l</ci>
                    </apply>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
        </math>
        <!--w_v_d = 0.5{dimensionless}+1{dimensionless}/pi*atan(v_d/v_scale);-->
        <!--w_v_d = sel
    case v_d > 0{dimensionless}:
        1{dimensionless};
    case v_d < 0{dimensionless}:
        0{dimensionless};
    otherwise:
        0.5{dimensionless};
endsel;-->
        <!--/////////////////////////coupling with RHS vessel using ode to break 
instaneous coupling requirement/////////-->
        <variable name="H_link_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_R</ci>
                <ci>H_L_out_RHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_link_L" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_L</ci>
                <ci>H_R_out_LHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_L_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_in</ci>
                <ci>H_link_L</ci>
            </apply>
        </math>
        <variable name="H_R_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_R_in</ci>
                <ci>H_link_R</ci>
            </apply>
        </math>
        <variable name="H_up" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_up</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="0.463812895643357" name="H_down" public_interface="out" units="dimensionless"/>
        <variable name="H_down_target" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_down_target</ci>
                <apply>
                    <times/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>s_v</ci>
                            <apply>
                                <plus/>
                                <ci>H_mean</ci>
                                <apply>
                                    <times/>
                                    <ci>gamma_mirror</ci>
                                    <apply>
                                        <minus/>
                                        <ci>H_mean</ci>
                                        <ci>H_up</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                                <ci>s_v</ci>
                            </apply>
                            <ci>H_mean</ci>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>stall</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>H_down</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>H_down_target</ci>
                        <ci>H_down</ci>
                    </apply>
                    <ci>tau_H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="s_v" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>s_v</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <apply>
                                <abs/>
                                <ci>v</ci>
                            </apply>
                            <ci>v_eps</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!--/useful when flow =0, if 0, make H_down=H_mean-->
        <variable name="H_L_out" public_interface="out" units="dimensionless"/>
        <variable name="H_R_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_out</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>w_v</ci>
                    </apply>
                    <ci>H_down</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_R_out</ci>
                <apply>
                    <times/>
                    <ci>w_v</ci>
                    <ci>H_down</ci>
                </apply>
            </apply>
        </math>
        <!--var blockage: dimensionles {pub:out};-->
        <!--var blockage: dimensionless {pub: out};-->
        <!--blockage = 1{dimensionless}-1{dimensionless}/(1{dimensionless}+pow(R_constriction/1e5{Js_per_m6}, 8{dimensionless}));-->
        <!--var R_constriction_blockage_threshold: Js_per_m6 {pub: in};-->
        <!--blockage = sel
    case R_constriction < R_constriction_blockage_threshold:
        0{dimensionless};
    otherwise:
        1{dimensionless};
endsel;-->
        <variable name="v_RBC" public_interface="out" units="m3_per_s"/>
        <variable name="v_d_RBC" public_interface="out" units="m3_per_s"/>
        <!--v_RBC   = 1.37{dimensionless}*v*(1{dimensionless}-(1{dimensionless}-w_v_d)*blockage);
v_d_RBC = 1.37{dimensionless}*v_d*(1{dimensionless}-w_v_d*blockage);-->
        <!--v_RBC   = 1.37{dimensionless}*v*(1{dimensionless}-blockage);
v_d_RBC = 1.37{dimensionless}*v_d*(1{dimensionless}-blockage);-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.37</cn>
                    <ci>v</ci>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>stall</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_d_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.37</cn>
                    <ci>v_d</ci>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>stall</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="1.9671001050678e-16" name="RBC_volume" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RBC_volume</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>v_RBC</ci>
                        <ci>RBC_volume_L</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>v_d_RBC</ci>
                        <ci>RBC_volume_R</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="RBC_volume_init" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_init</ci>
                <apply>
                    <times/>
                    <ci>H_global_L</ci>
                    <ci>q_us</ci>
                </apply>
            </apply>
            <!--var H_target: dimensionless {pub: out};-->
            <!--H_target = RBC_volume/q;-->
            <apply>
                <eq/>
                <ci>H_mean</ci>
                <apply>
                    <divide/>
                    <ci>RBC_volume</ci>
                    <ci>q</ci>
                </apply>
            </apply>
        </math>
        <variable name="H_mean" public_interface="out" units="dimensionless"/>
        <!--ode(H_mean, t) = (H_target-H_mean)/tau_H_mean;-->
        <variable name="RBC_volume_L" public_interface="out" units="dimensionless"/>
        <variable name="RBC_volume_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_L</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_L_out</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>RBC_volume_R</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_R_out</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--//////////////-->
        <!--var q_C: m3 {init: q_C_init, pub: out};-->
        <variable name="q" public_interface="out" units="m3"/>
        <variable name="q_us" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q_us</ci>
                <apply>
                    <times/>
                    <pi/>
                    <apply>
                        <power/>
                        <ci>r</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <ci>l</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q</ci>
                <ci>q_us</ci>
            </apply>
        </math>
        <variable name="Z" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Z</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">0.8</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">0.075</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <divide/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <power/>
                                            <cn cellml:units="dimensionless">10</cn>
                                            <apply>
                                                <minus/>
                                                <cn cellml:units="dimensionless">11</cn>
                                            </apply>
                                        </apply>
                                        <apply>
                                            <power/>
                                            <apply>
                                                <times/>
                                                <cn cellml:units="dimensionless">2</cn>
                                                <ci>r</ci>
                                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                            </apply>
                                            <cn cellml:units="dimensionless">12</cn>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <cn cellml:units="dimensionless">10</cn>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">11</cn>
                                    </apply>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">12</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu_45" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu_45</ci>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">6</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="per_m">0.085</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">3.2</cn>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.44</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">0.06</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="per_m">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">0.645</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu" public_interface="out" units="Js_per_m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu</ci>
                <apply>
                    <times/>
                    <ci>hem_dep_u_rel</ci>
                    <ci>mu_plasma</ci>
                </apply>
            </apply>
        </math>
        <variable name="hem_dep_u_rel" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>hem_dep_u_rel</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <ci>mu_45</ci>
                                    <cn cellml:units="dimensionless">1</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <power/>
                                        <apply>
                                            <minus/>
                                            <cn cellml:units="dimensionless">1</cn>
                                            <ci>H_mean</ci>
                                        </apply>
                                        <ci>Z</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">1</cn>
                                </apply>
                            </apply>
                            <apply>
                                <minus/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">1</cn>
                                        <ci>H_global_L</ci>
                                    </apply>
                                    <ci>Z</ci>
                                </apply>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                        </apply>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="metre">1.1</cn>
                                </apply>
                            </apply>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="Re_stall" public_interface="in" units="Js_per_m6"/>
        <!--1e21 for stalled resistance-->
        <variable name="R" public_interface="out" units="Js_per_m6"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">8</cn>
                            <ci>mu</ci>
                            <ci>l</ci>
                        </apply>
                        <apply>
                            <times/>
                            <pi/>
                            <apply>
                                <power/>
                                <ci>r</ci>
                                <cn cellml:units="dimensionless">4</cn>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Re_stall</ci>
                        <ci>stall</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="v" public_interface="out" units="m3_per_s"/>
        <variable name="v_mm3_s" public_interface="out" units="mm3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_mm3_s</ci>
                <apply>
                    <divide/>
                    <ci>v</ci>
                    <ci>one_mm3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_in</ci>
                        <ci>u_out</ci>
                    </apply>
                    <ci>R</ci>
                </apply>
            </apply>
        </math>
        <!--var u: J_per_m3 {pub: out};
var u_mmHg: dimensionless {pub: out};-->
        <!--u_mmHg      = u/133.322{J_per_m3};
u           = q_C/C+u_ext;
ode(q_C, t) = v-v_d;-->
        <variable name="v_d" public_interface="out" units="m3_per_s"/>
        <variable name="v_d_mm3_s" public_interface="out" units="mm3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_d_mm3_s</ci>
                <apply>
                    <divide/>
                    <ci>v_d</ci>
                    <ci>one_mm3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_d</ci>
                <ci>v</ci>
            </apply>
        </math>
        <!--///////////////radius modulation////////////////////-->
        <variable name="r_m" public_interface="out" units="metre"/>
        <!--modulated radius-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>r_m</ci>
                <apply>
                    <times/>
                    <ci>alpha</ci>
                    <ci>r</ci>
                </apply>
            </apply>
        </math>
        <variable name="alpha" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>alpha</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <ci>alpha_max</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                        <ci>K_deprived</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--var alpha_target: dimensionless {pub:out};
alpha_target = 1{dimensionless}+(alpha_max-1{dimensionless})/(1{dimensionless}+pow(10{dimensionless}*abs(v_downstream)/(v_base+v_eps), 4{dimensionless}));
alpha_target=1{dimensionless}+(alpha_max-1{dimensionless})*q_deprived;
the number 10 above says when flow in the pericyte is 10% of baseline flowing state, is the midpoint and vessel starts dilating
var alpha_init: dimensionless { pub: in};-->
        <variable name="tau_K_deprived" public_interface="in" units="second"/>
        <variable name="alpha_max" public_interface="in" units="dimensionless"/>
        <variable name="alpha_min" public_interface="in" units="dimensionless"/>
        <variable name="BOSF_Bx" public_interface="in" units="m3_per_s"/>
        <!--branch-order_specific_flow-->
        <variable initial_value="K_deprived_init" name="K_deprived" public_interface="out" units="dimensionless"/>
        <variable name="K_deprived_init" public_interface="in" units="dimensionless"/>
        <!--should be initilaized to 0 for alpha to start at 1-->
        <variable name="deprivation_sensor" public_interface="out" units="dimensionless"/>
        <variable name="f_crit" public_interface="in" units="dimensionless"/>
        <!--critical fraction of flow to baseline flow where it is considered half deprived, e.g if 10 then 1/10=is ur flow i 10% of baseline flow you are cosnidered half deprived-->
        <variable name="n" public_interface="in" units="dimensionless"/>
        <!--controls steepness of function, at 8 its like a step wise function-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>deprivation_sensor</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>f_crit</ci>
                                    <apply>
                                        <abs/>
                                        <ci>v</ci>
                                    </apply>
                                </apply>
                                <ci>BOSF_Bx</ci>
                            </apply>
                            <ci>n</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>K_deprived</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>deprivation_sensor</ci>
                        <ci>K_deprived</ci>
                    </apply>
                    <ci>tau_K_deprived</ci>
                </apply>
            </apply>
        </math>
        <variable name="r_stall" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>r_stall</ci>
                <apply>
                    <times/>
                    <ci>r</ci>
                    <cn cellml:units="dimensionless">1.05</cn>
                </apply>
            </apply>
        </math>
        <variable name="r_thresh" public_interface="out" units="metre"/>
        <!--r_thresh      = r_stall*(1{dimensionless}+fs*(1{dimensionless}-deformation_force));-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>r_thresh</ci>
                <apply>
                    <times/>
                    <ci>r_stall</ci>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <times/>
                            <ci>fs</ci>
                            <ci>low_q</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="low_q_init" name="low_q" public_interface="out" units="dimensionless"/>
        <variable initial_value="0" name="low_q_init" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.1" name="tau_low_q" public_interface="out" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>low_q</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>deprivation_sensor</ci>
                        <ci>low_q</ci>
                    </apply>
                    <ci>tau_low_q</ci>
                </apply>
            </apply>
        </math>
        <variable name="Z_ref" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Z_ref</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">0.8</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">0.075</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <divide/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <power/>
                                            <cn cellml:units="dimensionless">10</cn>
                                            <apply>
                                                <minus/>
                                                <cn cellml:units="dimensionless">11</cn>
                                            </apply>
                                        </apply>
                                        <apply>
                                            <power/>
                                            <apply>
                                                <times/>
                                                <cn cellml:units="dimensionless">2</cn>
                                                <ci>r</ci>
                                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                            </apply>
                                            <cn cellml:units="dimensionless">12</cn>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <cn cellml:units="dimensionless">10</cn>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">11</cn>
                                    </apply>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">12</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu_45_ref" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu_45_ref</ci>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">6</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="per_m">0.085</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">3.2</cn>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.44</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">0.06</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="per_m">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">0.645</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu_ref" public_interface="out" units="Js_per_m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu_ref</ci>
                <apply>
                    <times/>
                    <ci>hem_dep_u_rel_ref</ci>
                    <ci>mu_plasma</ci>
                </apply>
            </apply>
        </math>
        <variable name="hem_dep_u_rel_ref" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>hem_dep_u_rel_ref</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <ci>mu_45_ref</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="metre">1.1</cn>
                                </apply>
                            </apply>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="wss" public_interface="out" units="J_per_m3"/>
        <variable name="wss_BOSF_ref" public_interface="out" units="J_per_m3"/>
        <variable name="wss_crit" public_interface="out" units="J_per_m3"/>
        <variable name="f_wss" public_interface="in" units="dimensionless"/>
        <!--var deformation_force: dimensionless {pub: out};//low deformation_force means high driving force, high means low drivign force, hence low flow and more stalls-->
        <variable name="retention" public_interface="out" units="dimensionless"/>
        <variable name="n_stall" public_interface="in" units="dimensionless"/>
        <variable name="fs" public_interface="in" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>wss</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">4</cn>
                        <ci>mu</ci>
                        <apply>
                            <abs/>
                            <ci>v</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <ci>r_m</ci>
                            <cn cellml:units="dimensionless">3</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>wss_BOSF_ref</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">4</cn>
                        <ci>mu_ref</ci>
                        <ci>BOSF_Bx</ci>
                    </apply>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <ci>r</ci>
                            <cn cellml:units="dimensionless">3</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>wss_crit</ci>
                <apply>
                    <times/>
                    <ci>f_wss</ci>
                    <ci>wss_BOSF_ref</ci>
                </apply>
            </apply>
            <!--deformation_force     = 1{dimensionless}/(1{dimensionless}+pow(wss_crit/wss, n_stall));-->
            <apply>
                <eq/>
                <ci>retention</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <ci>wss</ci>
                                <ci>wss_crit</ci>
                            </apply>
                            <ci>n_stall</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="stall_target" public_interface="out" units="dimensionless"/>
        <variable initial_value="0" name="stall_memory" public_interface="out" units="dimensionless"/>
        <variable name="stall_init" public_interface="in" units="dimensionless"/>
        <variable name="stall" public_interface="out" units="dimensionless"/>
        <variable name="tau_stall" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>stall_target</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <lt/>
                            <ci>r_m</ci>
                            <ci>r_thresh</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>stall_memory</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>stall_target</ci>
                        <ci>stall_memory</ci>
                    </apply>
                    <ci>tau_stall</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>stall</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>stall_memory</ci>
                            <cn cellml:units="dimensionless">0.5</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
    </component>
    <!-- inlined from switching_test_modules.cellml -->
    <component name="PV2_module">
        <!--import variables-->
        <variable name="v_downstream_RHS" public_interface="in" units="m3_per_s"/>
        <variable name="v_downstream_LHS" public_interface="in" units="m3_per_s"/>
        <variable name="v_downstream" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_downstream</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>v_downstream_RHS</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>v_downstream_LHS</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="tau_sig" public_interface="in" units="second"/>
        <variable name="t0" public_interface="in" units="second"/>
        <variable name="t" public_interface="in" units="second"/>
        <!--var R_constriction_base: Js_per_m6 {pub: in};
var R_constriction_final: Js_per_m6 {pub: in};
var R_constriction: Js_per_m6 {pub: out};-->
        <!--R_constriction = R_constriction_base+(R_constriction_final-R_constriction_base)/(1{dimensionless}+exp(-(t-t0)/tau_sig));-->
        <variable name="H_global_L" public_interface="in" units="dimensionless"/>
        <variable name="H_global_R" public_interface="in" units="dimensionless"/>
        <variable name="H_L_out_RHS" public_interface="in" units="dimensionless"/>
        <variable name="H_R_out_LHS" public_interface="in" units="dimensionless"/>
        <variable name="gamma_mirror" public_interface="in" units="dimensionless"/>
        <variable name="tau_H_down" public_interface="in" units="second"/>
        <variable name="tau_H_mean" public_interface="in" units="second"/>
        <!--0.001-->
        <variable name="v_eps" public_interface="in" units="m3_per_s"/>
        <!--var q_C_init: m3 {pub: in};-->
        <!--0-->
        <variable name="l" public_interface="in" units="metre"/>
        <variable name="r" public_interface="in" units="metre"/>
        <!--var tau_base: second {pub: in};
var gate: dimensionless {pub: out};
var v_base: m3_per_s {init: 0, pub: out};-->
        <!--gate = sel
    case t < t0:
        1{dimensionless};
    otherwise:
        0{dimensionless};
endsel;-->
        <!--ode(v_base, t) = gate*(abs(v)-v_base)/tau_base;-->
        <variable name="mu_plasma" public_interface="in" units="Js_per_m3"/>
        <variable name="u_in" public_interface="in" units="J_per_m3"/>
        <!--var u_ext: J_per_m3 {pub: in};-->
        <variable name="u_out" public_interface="in" units="J_per_m3"/>
        <variable name="tau_link" public_interface="in" units="second"/>
        <variable name="v_scale" public_interface="in" units="m3_per_s"/>
        <variable name="one_mm3" public_interface="in" units="m3"/>
        <variable name="w_v" public_interface="out" units="dimensionless"/>
        <!--var w_v_d: dimensionless {pub: out};-->
        <!--w_v   = 0.5{dimensionless}+1{dimensionless}/pi*atan(v/v_scale);-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_v</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>v</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <piece>
                        <cn cellml:units="dimensionless">0</cn>
                        <apply>
                            <lt/>
                            <ci>v</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0.5</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!--/////compliance kept in new modules for compliance port mapping 
for VV junction compliance determination-->
        <variable name="C" public_interface="out" units="m6_per_J"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>C</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <cn cellml:units="metre" type="e-notation">8.5<sep/>-9</cn>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                        <ci>l</ci>
                    </apply>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
        </math>
        <!--w_v_d = 0.5{dimensionless}+1{dimensionless}/pi*atan(v_d/v_scale);-->
        <!--w_v_d = sel
    case v_d > 0{dimensionless}:
        1{dimensionless};
    case v_d < 0{dimensionless}:
        0{dimensionless};
    otherwise:
        0.5{dimensionless};
endsel;-->
        <!--/////////////////////////coupling with RHS vessel using ode to break 
instaneous coupling requirement/////////-->
        <variable name="H_link_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_R</ci>
                <ci>H_L_out_RHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_link_L" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_L</ci>
                <ci>H_R_out_LHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_L_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_in</ci>
                <ci>H_link_L</ci>
            </apply>
        </math>
        <variable name="H_R_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_R_in</ci>
                <ci>H_link_R</ci>
            </apply>
        </math>
        <variable name="H_up" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_up</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="0" name="H_down" public_interface="out" units="dimensionless"/>
        <variable name="H_down_target" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_down_target</ci>
                <apply>
                    <times/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>s_v</ci>
                            <apply>
                                <plus/>
                                <ci>H_mean</ci>
                                <apply>
                                    <times/>
                                    <ci>gamma_mirror</ci>
                                    <apply>
                                        <minus/>
                                        <ci>H_mean</ci>
                                        <ci>H_up</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                                <ci>s_v</ci>
                            </apply>
                            <ci>H_mean</ci>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>stall</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>H_down</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>H_down_target</ci>
                        <ci>H_down</ci>
                    </apply>
                    <ci>tau_H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="s_v" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>s_v</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <apply>
                                <abs/>
                                <ci>v</ci>
                            </apply>
                            <ci>v_eps</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!--/useful when flow =0, if 0, make H_down=H_mean-->
        <variable name="H_L_out" public_interface="out" units="dimensionless"/>
        <variable name="H_R_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_out</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>w_v</ci>
                    </apply>
                    <ci>H_down</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_R_out</ci>
                <apply>
                    <times/>
                    <ci>w_v</ci>
                    <ci>H_down</ci>
                </apply>
            </apply>
        </math>
        <!--var blockage: dimensionles {pub:out};-->
        <!--var blockage: dimensionless {pub: out};-->
        <!--blockage = 1{dimensionless}-1{dimensionless}/(1{dimensionless}+pow(R_constriction/1e5{Js_per_m6}, 8{dimensionless}));-->
        <!--var R_constriction_blockage_threshold: Js_per_m6 {pub: in};-->
        <!--blockage = sel
    case R_constriction < R_constriction_blockage_threshold:
        0{dimensionless};
    otherwise:
        1{dimensionless};
endsel;-->
        <variable name="v_RBC" public_interface="out" units="m3_per_s"/>
        <variable name="v_d_RBC" public_interface="out" units="m3_per_s"/>
        <!--v_RBC   = 1.37{dimensionless}*v*(1{dimensionless}-(1{dimensionless}-w_v_d)*blockage);
v_d_RBC = 1.37{dimensionless}*v_d*(1{dimensionless}-w_v_d*blockage);-->
        <!--v_RBC   = 1.37{dimensionless}*v*(1{dimensionless}-blockage);
v_d_RBC = 1.37{dimensionless}*v_d*(1{dimensionless}-blockage);-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.37</cn>
                    <ci>v</ci>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>stall</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_d_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.37</cn>
                    <ci>v_d</ci>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>stall</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="1.58448742526483e-16" name="RBC_volume" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RBC_volume</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>v_RBC</ci>
                        <ci>RBC_volume_L</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>v_d_RBC</ci>
                        <ci>RBC_volume_R</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="RBC_volume_init" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_init</ci>
                <apply>
                    <times/>
                    <ci>H_global_L</ci>
                    <ci>q_us</ci>
                </apply>
            </apply>
            <!--var H_target: dimensionless {pub: out};-->
            <!--H_target = RBC_volume/q;-->
            <apply>
                <eq/>
                <ci>H_mean</ci>
                <apply>
                    <divide/>
                    <ci>RBC_volume</ci>
                    <ci>q</ci>
                </apply>
            </apply>
        </math>
        <variable name="H_mean" public_interface="out" units="dimensionless"/>
        <!--ode(H_mean, t) = (H_target-H_mean)/tau_H_mean;-->
        <variable name="RBC_volume_L" public_interface="out" units="dimensionless"/>
        <variable name="RBC_volume_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_L</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_L_out</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>RBC_volume_R</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_R_out</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--//////////////-->
        <!--var q_C: m3 {init: q_C_init, pub: out};-->
        <variable name="q" public_interface="out" units="m3"/>
        <variable name="q_us" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q_us</ci>
                <apply>
                    <times/>
                    <pi/>
                    <apply>
                        <power/>
                        <ci>r</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <ci>l</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q</ci>
                <ci>q_us</ci>
            </apply>
        </math>
        <variable name="Z" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Z</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">0.8</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">0.075</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <divide/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <power/>
                                            <cn cellml:units="dimensionless">10</cn>
                                            <apply>
                                                <minus/>
                                                <cn cellml:units="dimensionless">11</cn>
                                            </apply>
                                        </apply>
                                        <apply>
                                            <power/>
                                            <apply>
                                                <times/>
                                                <cn cellml:units="dimensionless">2</cn>
                                                <ci>r</ci>
                                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                            </apply>
                                            <cn cellml:units="dimensionless">12</cn>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <cn cellml:units="dimensionless">10</cn>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">11</cn>
                                    </apply>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">12</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu_45" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu_45</ci>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">6</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="per_m">0.085</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">3.2</cn>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.44</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">0.06</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="per_m">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">0.645</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu" public_interface="out" units="Js_per_m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu</ci>
                <apply>
                    <times/>
                    <ci>hem_dep_u_rel</ci>
                    <ci>mu_plasma</ci>
                </apply>
            </apply>
        </math>
        <variable name="hem_dep_u_rel" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>hem_dep_u_rel</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <ci>mu_45</ci>
                                    <cn cellml:units="dimensionless">1</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <power/>
                                        <apply>
                                            <minus/>
                                            <cn cellml:units="dimensionless">1</cn>
                                            <ci>H_mean</ci>
                                        </apply>
                                        <ci>Z</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">1</cn>
                                </apply>
                            </apply>
                            <apply>
                                <minus/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">1</cn>
                                        <ci>H_global_L</ci>
                                    </apply>
                                    <ci>Z</ci>
                                </apply>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                        </apply>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="metre">1.1</cn>
                                </apply>
                            </apply>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="Re_stall" public_interface="in" units="Js_per_m6"/>
        <!--1e21 for stalled resistance-->
        <variable name="R" public_interface="out" units="Js_per_m6"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">8</cn>
                            <ci>mu</ci>
                            <ci>l</ci>
                        </apply>
                        <apply>
                            <times/>
                            <pi/>
                            <apply>
                                <power/>
                                <ci>r</ci>
                                <cn cellml:units="dimensionless">4</cn>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Re_stall</ci>
                        <ci>stall</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="v" public_interface="out" units="m3_per_s"/>
        <variable name="v_mm3_s" public_interface="out" units="mm3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_mm3_s</ci>
                <apply>
                    <divide/>
                    <ci>v</ci>
                    <ci>one_mm3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_in</ci>
                        <ci>u_out</ci>
                    </apply>
                    <ci>R</ci>
                </apply>
            </apply>
        </math>
        <!--var u: J_per_m3 {pub: out};
var u_mmHg: dimensionless {pub: out};-->
        <!--u_mmHg      = u/133.322{J_per_m3};
u           = q_C/C+u_ext;
ode(q_C, t) = v-v_d;-->
        <variable name="v_d" public_interface="out" units="m3_per_s"/>
        <variable name="v_d_mm3_s" public_interface="out" units="mm3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_d_mm3_s</ci>
                <apply>
                    <divide/>
                    <ci>v_d</ci>
                    <ci>one_mm3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_d</ci>
                <ci>v</ci>
            </apply>
        </math>
        <!--///////////////radius modulation////////////////////-->
        <variable name="r_m" public_interface="out" units="metre"/>
        <!--modulated radius-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>r_m</ci>
                <apply>
                    <times/>
                    <ci>alpha</ci>
                    <ci>r</ci>
                </apply>
            </apply>
        </math>
        <variable name="alpha" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>alpha</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <ci>alpha_max</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                        <ci>K_deprived</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--var alpha_target: dimensionless {pub:out};
alpha_target = 1{dimensionless}+(alpha_max-1{dimensionless})/(1{dimensionless}+pow(10{dimensionless}*abs(v_downstream)/(v_base+v_eps), 4{dimensionless}));
alpha_target=1{dimensionless}+(alpha_max-1{dimensionless})*q_deprived;
the number 10 above says when flow in the pericyte is 10% of baseline flowing state, is the midpoint and vessel starts dilating
var alpha_init: dimensionless { pub: in};-->
        <variable name="tau_K_deprived" public_interface="in" units="second"/>
        <variable name="alpha_max" public_interface="in" units="dimensionless"/>
        <variable name="alpha_min" public_interface="in" units="dimensionless"/>
        <variable name="BOSF_Bx" public_interface="in" units="m3_per_s"/>
        <!--branch-order_specific_flow-->
        <variable initial_value="K_deprived_init" name="K_deprived" public_interface="out" units="dimensionless"/>
        <variable name="K_deprived_init" public_interface="in" units="dimensionless"/>
        <!--should be initilaized to 0 for alpha to start at 1-->
        <variable name="deprivation_sensor" public_interface="out" units="dimensionless"/>
        <variable name="f_crit" public_interface="in" units="dimensionless"/>
        <!--critical fraction of flow to baseline flow where it is considered half deprived, e.g if 10 then 1/10=is ur flow i 10% of baseline flow you are cosnidered half deprived-->
        <variable name="n" public_interface="in" units="dimensionless"/>
        <!--controls steepness of function, at 8 its like a step wise function-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>deprivation_sensor</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>f_crit</ci>
                                    <apply>
                                        <abs/>
                                        <ci>v</ci>
                                    </apply>
                                </apply>
                                <ci>BOSF_Bx</ci>
                            </apply>
                            <ci>n</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>K_deprived</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>deprivation_sensor</ci>
                        <ci>K_deprived</ci>
                    </apply>
                    <ci>tau_K_deprived</ci>
                </apply>
            </apply>
        </math>
        <variable name="r_stall" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>r_stall</ci>
                <apply>
                    <times/>
                    <ci>r</ci>
                    <cn cellml:units="dimensionless">1.05</cn>
                </apply>
            </apply>
        </math>
        <variable name="r_thresh" public_interface="out" units="metre"/>
        <!--r_thresh      = r_stall*(1{dimensionless}+fs*(1{dimensionless}-deformation_force));-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>r_thresh</ci>
                <apply>
                    <times/>
                    <ci>r_stall</ci>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <times/>
                            <ci>fs</ci>
                            <ci>low_q</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="low_q_init" name="low_q" public_interface="out" units="dimensionless"/>
        <variable initial_value="0" name="low_q_init" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.1" name="tau_low_q" public_interface="out" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>low_q</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>deprivation_sensor</ci>
                        <ci>low_q</ci>
                    </apply>
                    <ci>tau_low_q</ci>
                </apply>
            </apply>
        </math>
        <variable name="Z_ref" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Z_ref</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">0.8</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">0.075</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <divide/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <power/>
                                            <cn cellml:units="dimensionless">10</cn>
                                            <apply>
                                                <minus/>
                                                <cn cellml:units="dimensionless">11</cn>
                                            </apply>
                                        </apply>
                                        <apply>
                                            <power/>
                                            <apply>
                                                <times/>
                                                <cn cellml:units="dimensionless">2</cn>
                                                <ci>r</ci>
                                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                            </apply>
                                            <cn cellml:units="dimensionless">12</cn>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <cn cellml:units="dimensionless">10</cn>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">11</cn>
                                    </apply>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">12</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu_45_ref" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu_45_ref</ci>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">6</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="per_m">0.085</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">3.2</cn>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.44</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">0.06</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="per_m">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">0.645</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu_ref" public_interface="out" units="Js_per_m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu_ref</ci>
                <apply>
                    <times/>
                    <ci>hem_dep_u_rel_ref</ci>
                    <ci>mu_plasma</ci>
                </apply>
            </apply>
        </math>
        <variable name="hem_dep_u_rel_ref" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>hem_dep_u_rel_ref</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <ci>mu_45_ref</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="metre">1.1</cn>
                                </apply>
                            </apply>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="wss" public_interface="out" units="J_per_m3"/>
        <variable name="wss_BOSF_ref" public_interface="out" units="J_per_m3"/>
        <variable name="wss_crit" public_interface="out" units="J_per_m3"/>
        <variable name="f_wss" public_interface="in" units="dimensionless"/>
        <!--var deformation_force: dimensionless {pub: out};//low deformation_force means high driving force, high means low drivign force, hence low flow and more stalls-->
        <variable name="retention" public_interface="out" units="dimensionless"/>
        <variable name="n_stall" public_interface="in" units="dimensionless"/>
        <variable name="fs" public_interface="in" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>wss</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">4</cn>
                        <ci>mu</ci>
                        <apply>
                            <abs/>
                            <ci>v</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <ci>r_m</ci>
                            <cn cellml:units="dimensionless">3</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>wss_BOSF_ref</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">4</cn>
                        <ci>mu_ref</ci>
                        <ci>BOSF_Bx</ci>
                    </apply>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <ci>r</ci>
                            <cn cellml:units="dimensionless">3</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>wss_crit</ci>
                <apply>
                    <times/>
                    <ci>f_wss</ci>
                    <ci>wss_BOSF_ref</ci>
                </apply>
            </apply>
            <!--deformation_force     = 1{dimensionless}/(1{dimensionless}+pow(wss_crit/wss, n_stall));-->
            <apply>
                <eq/>
                <ci>retention</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <ci>wss</ci>
                                <ci>wss_crit</ci>
                            </apply>
                            <ci>n_stall</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="stall_target" public_interface="out" units="dimensionless"/>
        <variable initial_value="1" name="stall_memory" public_interface="out" units="dimensionless"/>
        <variable name="stall_init" public_interface="in" units="dimensionless"/>
        <variable name="stall" public_interface="out" units="dimensionless"/>
        <variable name="tau_stall" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>stall_target</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <lt/>
                            <ci>r_m</ci>
                            <ci>r_thresh</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>stall_memory</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>stall_target</ci>
                        <ci>stall_memory</ci>
                    </apply>
                    <ci>tau_stall</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>stall</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>stall_memory</ci>
                            <cn cellml:units="dimensionless">0.5</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
    </component>
    <!-- inlined from switching_test_modules.cellml -->
    <component name="V1_module">
        <!--import variables-->
        <variable name="t" public_interface="in" units="second"/>
        <variable name="H_global_L" public_interface="in" units="dimensionless"/>
        <variable name="H_global_R" public_interface="in" units="dimensionless"/>
        <variable name="H_L_out_RHS" public_interface="in" units="dimensionless"/>
        <variable name="H_R_out_LHS" public_interface="in" units="dimensionless"/>
        <variable name="gamma_mirror" public_interface="in" units="dimensionless"/>
        <variable name="tau_H_down" public_interface="in" units="second"/>
        <variable name="tau_H_mean" public_interface="in" units="second"/>
        <!--0.001-->
        <variable name="v_eps" public_interface="in" units="m3_per_s"/>
        <variable name="q_C_init" public_interface="in" units="m3"/>
        <!--0-->
        <variable name="l" public_interface="in" units="metre"/>
        <variable name="r" public_interface="in" units="metre"/>
        <variable name="mu_plasma" public_interface="in" units="Js_per_m3"/>
        <variable name="v_in" public_interface="in" units="m3_per_s"/>
        <variable name="u_ext" public_interface="in" units="J_per_m3"/>
        <variable name="u_out" public_interface="in" units="J_per_m3"/>
        <variable name="tau_link" public_interface="in" units="second"/>
        <variable name="v_scale" public_interface="in" units="m3_per_s"/>
        <variable name="one_mm3" public_interface="in" units="m3"/>
        <variable name="w_v" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_v</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>v</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--/////////////////////////coupling with RHS vessel using ode to break 
instaneous coupling requirement/////////-->
        <variable name="H_link_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_R</ci>
                <ci>H_L_out_RHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_link_L" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_L</ci>
                <ci>H_R_out_LHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_L_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_in</ci>
                <ci>H_link_L</ci>
            </apply>
        </math>
        <variable name="H_R_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_R_in</ci>
                <ci>H_link_R</ci>
            </apply>
        </math>
        <variable name="H_up" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_up</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="0.463812958396349" name="H_down" public_interface="out" units="dimensionless"/>
        <variable name="H_down_target" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_down_target</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>s_v</ci>
                        <apply>
                            <plus/>
                            <ci>H_mean</ci>
                            <apply>
                                <times/>
                                <ci>gamma_mirror</ci>
                                <apply>
                                    <minus/>
                                    <ci>H_mean</ci>
                                    <ci>H_up</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>s_v</ci>
                        </apply>
                        <ci>H_mean</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>H_down</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>H_down_target</ci>
                        <ci>H_down</ci>
                    </apply>
                    <ci>tau_H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="s_v" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>s_v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <abs/>
                        <ci>v</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <abs/>
                            <ci>v</ci>
                        </apply>
                        <ci>v_eps</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--/useful when flow =0, if 0, make H_down=H_mean-->
        <variable name="H_L_out" public_interface="out" units="dimensionless"/>
        <variable name="H_R_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_out</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>w_v</ci>
                    </apply>
                    <ci>H_down</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_R_out</ci>
                <apply>
                    <times/>
                    <ci>w_v</ci>
                    <ci>H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="v_in_RBC" public_interface="out" units="m3_per_s"/>
        <variable name="v_RBC" public_interface="out" units="m3_per_s"/>
        <!--v_RBC   = 1.37{dimensionless}*v*(1{dimensionless}-(1{dimensionless}-w_v)*blockage);
v_in_RBC = 1.37{dimensionless}*v_in*(1{dimensionless}-w_d*blockage);
the above formulas are for if we wanna have the sections with the flow before the vlockage site to be unaffected by the blockage -->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_in_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.3</cn>
                    <ci>v_in</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.3</cn>
                    <ci>v</ci>
                </apply>
            </apply>
        </math>
        <variable initial_value="2.10115279975442e-15" name="RBC_volume" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RBC_volume</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>v_in_RBC</ci>
                        <ci>RBC_volume_L</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>v_RBC</ci>
                        <ci>RBC_volume_R</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="RBC_volume_init" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_init</ci>
                <apply>
                    <times/>
                    <ci>H_global_L</ci>
                    <ci>q_us</ci>
                </apply>
            </apply>
            <!--pos/neg for RBC mass conservation only-->
            <!-- outflow to left (v<0)-->
            <!--var H_target: dimensionless {pub: out};-->
            <!--H_target = RBC_volume/q;-->
            <apply>
                <eq/>
                <ci>H_mean</ci>
                <apply>
                    <divide/>
                    <ci>RBC_volume</ci>
                    <ci>q</ci>
                </apply>
            </apply>
        </math>
        <variable name="H_mean" public_interface="out" units="dimensionless"/>
        <!--ode(H_mean, t) = (H_target-H_mean)/tau_H_mean;-->
        <variable name="RBC_volume_L" public_interface="out" units="dimensionless"/>
        <variable name="RBC_volume_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_L</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_L_out</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>RBC_volume_R</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_R_out</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--//////////////-->
        <variable initial_value="1.56689716772442e-18" name="q_C" public_interface="out" units="m3"/>
        <variable name="q" public_interface="out" units="m3"/>
        <variable name="q_us" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q_us</ci>
                <apply>
                    <times/>
                    <pi/>
                    <apply>
                        <power/>
                        <ci>r</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <ci>l</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q</ci>
                <apply>
                    <plus/>
                    <ci>q_us</ci>
                    <ci>q_C</ci>
                </apply>
            </apply>
        </math>
        <variable name="C" public_interface="out" units="m6_per_J"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>C</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <cn cellml:units="metre" type="e-notation">8.5<sep/>-9</cn>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                        <ci>l</ci>
                    </apply>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
        </math>
        <variable name="Z" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Z</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">0.8</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">0.075</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <divide/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <power/>
                                            <cn cellml:units="dimensionless">10</cn>
                                            <apply>
                                                <minus/>
                                                <cn cellml:units="dimensionless">11</cn>
                                            </apply>
                                        </apply>
                                        <apply>
                                            <power/>
                                            <apply>
                                                <times/>
                                                <cn cellml:units="dimensionless">2</cn>
                                                <ci>r</ci>
                                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                            </apply>
                                            <cn cellml:units="dimensionless">12</cn>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <cn cellml:units="dimensionless">10</cn>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">11</cn>
                                    </apply>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">12</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu_45" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu_45</ci>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">6</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="per_m">0.085</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">3.2</cn>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.44</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">0.06</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="per_m">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">0.645</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="mu" public_interface="out" units="Js_per_m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>mu</ci>
                <apply>
                    <times/>
                    <ci>hem_dep_u_rel</ci>
                    <ci>mu_plasma</ci>
                </apply>
            </apply>
        </math>
        <variable name="hem_dep_u_rel" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>hem_dep_u_rel</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <ci>mu_45</ci>
                                    <cn cellml:units="dimensionless">1</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <power/>
                                        <apply>
                                            <minus/>
                                            <cn cellml:units="dimensionless">1</cn>
                                            <ci>H_mean</ci>
                                        </apply>
                                        <ci>Z</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">1</cn>
                                </apply>
                            </apply>
                            <apply>
                                <minus/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="dimensionless">1</cn>
                                        <ci>H_global_L</ci>
                                    </apply>
                                    <ci>Z</ci>
                                </apply>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                        </apply>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="dimensionless">2</cn>
                                    <ci>r</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <times/>
                                        <cn cellml:units="dimensionless">2</cn>
                                        <ci>r</ci>
                                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                    </apply>
                                    <cn cellml:units="metre">1.1</cn>
                                </apply>
                            </apply>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="R" public_interface="out" units="Js_per_m6"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">8</cn>
                        <ci>mu</ci>
                        <ci>l</ci>
                    </apply>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <ci>r</ci>
                            <cn cellml:units="dimensionless">4</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="v" public_interface="out" units="m3_per_s"/>
        <variable name="v_mm3_s" public_interface="out" units="mm3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_mm3_s</ci>
                <apply>
                    <divide/>
                    <ci>v</ci>
                    <ci>one_mm3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u</ci>
                        <ci>u_out</ci>
                    </apply>
                    <ci>R</ci>
                </apply>
            </apply>
        </math>
        <variable name="u" public_interface="out" units="J_per_m3"/>
        <variable name="u_mmHg" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>u_mmHg</ci>
                <apply>
                    <divide/>
                    <ci>u</ci>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <ci>q_C</ci>
                        <ci>C</ci>
                    </apply>
                    <ci>u_ext</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_C</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v_in</ci>
                    <ci>v</ci>
                </apply>
            </apply>
        </math>
    </component>
    <!-- inlined from switching_test_modules.cellml -->
    <component name="V2_module">
        <!--import variables-->
        <variable name="t" public_interface="in" units="second"/>
        <variable name="H_global_L" public_interface="in" units="dimensionless"/>
        <variable name="H_global_R" public_interface="in" units="dimensionless"/>
        <variable name="H_L_out_RHS" public_interface="in" units="dimensionless"/>
        <variable name="H_R_out_LHS" public_interface="in" units="dimensionless"/>
        <variable name="gamma_mirror" public_interface="in" units="dimensionless"/>
        <variable name="tau_H_down" public_interface="in" units="second"/>
        <variable name="tau_H_mean" public_interface="in" units="second"/>
        <!--0.001-->
        <variable name="v_eps" public_interface="in" units="m3_per_s"/>
        <variable name="q_C_init" public_interface="in" units="m3"/>
        <!--0-->
        <variable name="l" public_interface="in" units="metre"/>
        <variable name="r" public_interface="in" units="metre"/>
        <variable name="mu_plasma" public_interface="in" units="Js_per_m3"/>
        <variable name="v_in" public_interface="in" units="m3_per_s"/>
        <variable name="u_ext" public_interface="in" units="J_per_m3"/>
        <variable name="u_out" public_interface="in" units="J_per_m3"/>
        <variable name="tau_link" public_interface="in" units="second"/>
        <variable name="v_scale" public_interface="in" units="m3_per_s"/>
        <variable name="one_mm3" public_interface="in" units="m3"/>
        <variable name="w_v" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_v</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>v</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--/////////////////////////coupling with RHS vessel using ode to break 
instaneous coupling requirement/////////-->
        <variable name="H_link_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_R</ci>
                <ci>H_L_out_RHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_link_L" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_L</ci>
                <ci>H_R_out_LHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_L_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_in</ci>
                <ci>H_link_L</ci>
            </apply>
        </math>
        <variable name="H_R_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_R_in</ci>
                <ci>H_link_R</ci>
            </apply>
        </math>
        <variable name="H_up" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_up</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="7.43642046782801e-05" name="H_down" public_interface="out" units="dimensionless"/>
        <variable name="H_down_target" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_down_target</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>s_v</ci>
                        <apply>
                            <plus/>
                            <ci>H_mean</ci>
                            <apply>
                                <times/>
                                <ci>gamma_mirror</ci>
                                <apply>
                                    <minus/>
                                    <ci>H_mean</ci>
                                    <ci>H_up</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>s_v</ci>
                        </apply>
                        <ci>H_mean</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>H_down</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>H_down_target</ci>
                        <ci>H_down</ci>
                    </apply>
                    <ci>tau_H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="s_v" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>s_v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <abs/>
                        <ci>v</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <abs/>
                            <ci>v</ci>
                        </apply>
                        <ci>v_eps</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--/useful when flow =0, if 0, make H_down=H_mean-->
        <variable name="H_L_out" public_interface="out" units="dimensionless"/>
        <variable name="H_R_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_out</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>w_v</ci>
                    </apply>
                    <ci>H_down</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_R_out</ci>
                <apply>
                    <times/>
                    <ci>w_v</ci>
                    <ci>H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="v_in_RBC" public_interface="out" units="m3_per_s"/>
        <variable name="v_RBC" public_interface="out" units="m3_per_s"/>
        <!--v_RBC   = 1.37{dimensionless}*v*(1{dimensionless}-(1{dimensionless}-w_v)*blockage);
v_in_RBC = 1.37{dimensionless}*v_in*(1{dimensionless}-w_d*blockage);
the above formulas are for if we wanna have the sections with the flow before the vlockage site to be unaffected by the blockage -->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_in_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.3</cn>
                    <ci>v_in</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.3</cn>
                    <ci>v</ci>
                </apply>
            </apply>
        </math>
        <variable initial_value="2.31221389985842e-19" name="RBC_volume" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RBC_volume</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>v_in_RBC</ci>
                        <ci>RBC_volume_L</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>v_RBC</ci>
                        <ci>RBC_volume_R</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="RBC_volume_init" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_init</ci>
                <apply>
                    <times/>
                    <ci>H_global_L</ci>
                    <ci>q_us</ci>
                </apply>
            </apply>
            <!--pos/neg for RBC mass conservation only-->
            <!-- outflow to left (v<0)-->
            <!--var H_target: dimensionless {pub: out};-->
            <!--H_target = RBC_volume/q;-->
            <apply>
                <eq/>
                <ci>H_mean</ci>
                <apply>
                    <divide/>
                    <ci>RBC_volume</ci>
                    <ci>q</ci>
                </apply>
            </apply>
        </math>
        <variable name="H_mean" public_interface="out" units="dimensionless"/>
        <!--ode(H_mean, t) = (H_target-H_mean)/tau_H_mean;-->
        <variable name="RBC_volume_L" public_interface="out" units="dimensionless"/>
        <variable name="RBC_volume_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_L</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
