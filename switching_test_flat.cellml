        <variable name="H_from1" public_interface="out" units="dimensionless"/>
        <variable name="H_from2" public_interface="out" units="dimensionless"/>
        <variable name="H_from3" public_interface="out" units="dimensionless"/>
        <variable name="H_from4" public_interface="out" units="dimensionless"/>
        <!-- When w_out ~ 0 (not a daughter), derivative ~0 => holds last daughter value.-->
        <!--ode(H_from1, t) = w_out1*(H_from1_target-H_from1)/tau_junc;-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_from1</ci>
                <apply>
                    <times/>
                    <ci>w_out1</ci>
                    <ci>H_from1_target</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_from2</ci>
                <apply>
                    <times/>
                    <ci>w_out2</ci>
                    <ci>H_from2_target</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_from3</ci>
                <apply>
                    <times/>
                    <ci>w_out3</ci>
                    <ci>H_from3_target</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_from4</ci>
                <apply>
                    <times/>
                    <ci>w_out4</ci>
                    <ci>H_from4_target</ci>
                </apply>
            </apply>
        </math>
        <!--ode(H_from2, t) = w_out2*(H_from2_target-H_from2)/tau_junc;
ode(H_from3, t) = w_out3*(H_from3_target-H_from3)/tau_junc;
ode(H_from4, t) = w_out4*(H_from4_target-H_from4)/tau_junc;-->
        <variable name="r_bc1" public_interface="in" units="metre"/>
        <!-- diameter of vessel at port 1 (junction side)-->
        <variable name="r_bc2" public_interface="in" units="metre"/>
        <!-- diameter of vessel at port 2-->
        <variable name="r_bc3" public_interface="in" units="metre"/>
        <!-- diameter of vessel at port 3-->
        <variable name="r_bc4" public_interface="in" units="metre"/>
        <variable name="D1" public_interface="out" units="metre"/>
        <!-- diameter of vessel at port 1 (junction side)-->
        <variable name="D2" public_interface="out" units="metre"/>
        <!-- diameter of vessel at port 2-->
        <variable name="D3" public_interface="out" units="metre"/>
        <!-- diameter of vessel at port 3-->
        <variable name="D4" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>D1</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r_bc1</ci>
                </apply>
            </apply>
            <!-- <&#45;&#45; port1 attached vessel diameter (example: parent VV side)-->
            <apply>
                <eq/>
                <ci>D2</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r_bc2</ci>
                </apply>
            </apply>
            <!-- <&#45;&#45; port2 (if unused, still define)-->
            <apply>
                <eq/>
                <ci>D3</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r_bc3</ci>
                </apply>
            </apply>
            <!-- <&#45;&#45; port3 daughter candidate-->
            <apply>
                <eq/>
                <ci>D4</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r_bc4</ci>
                </apply>
            </apply>
        </math>
        <variable name="w_in1" public_interface="out" units="dimensionless"/>
        <variable name="w_in2" public_interface="out" units="dimensionless"/>
        <variable name="w_in3" public_interface="out" units="dimensionless"/>
        <variable name="w_in4" public_interface="out" units="dimensionless"/>
        <!--1 when vj is positive, 0 when vj is 0-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_in1</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>vj1</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_in2</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>vj2</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_in3</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>vj3</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_in4</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <pi/>
                        </apply>
                        <apply>
                            <arctan/>
                            <apply>
                                <divide/>
                                <ci>vj4</ci>
                                <ci>v_scale</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="w_out1" public_interface="out" units="dimensionless"/>
        <variable name="w_out2" public_interface="out" units="dimensionless"/>
        <variable name="w_out3" public_interface="out" units="dimensionless"/>
        <variable name="w_out4" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_out1</ci>
                <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>w_in1</ci>
                </apply>
            </apply>
            <!-- ~1 if vj1<0-->
            <apply>
                <eq/>
                <ci>w_out2</ci>
                <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>w_in2</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_out3</ci>
                <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>w_in3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_out4</ci>
                <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>w_in4</ci>
                </apply>
            </apply>
        </math>
        <variable name="Qin1" public_interface="out" units="m3_per_s"/>
        <variable name="Qin2" public_interface="out" units="m3_per_s"/>
        <variable name="Qin3" public_interface="out" units="m3_per_s"/>
        <variable name="Qin4" public_interface="out" units="m3_per_s"/>
        <variable name="Qout1" public_interface="out" units="m3_per_s"/>
        <variable name="Qout2" public_interface="out" units="m3_per_s"/>
        <variable name="Qout3" public_interface="out" units="m3_per_s"/>
        <variable name="Qout4" public_interface="out" units="m3_per_s"/>
        <!--absolute flow into the junction-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Qin1</ci>
                <apply>
                    <times/>
                    <ci>w_in1</ci>
                    <ci>vj1</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qin2</ci>
                <apply>
                    <times/>
                    <ci>w_in2</ci>
                    <ci>vj2</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qin3</ci>
                <apply>
                    <times/>
                    <ci>w_in3</ci>
                    <ci>vj3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qin4</ci>
                <apply>
                    <times/>
                    <ci>w_in4</ci>
                    <ci>vj4</ci>
                </apply>
            </apply>
            <!--absolute (magnitude) of flow out of the junction-->
            <apply>
                <eq/>
                <ci>Qout1</ci>
                <apply>
                    <times/>
                    <ci>w_out1</ci>
                    <apply>
                        <minus/>
                        <ci>vj1</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qout2</ci>
                <apply>
                    <times/>
                    <ci>w_out2</ci>
                    <apply>
                        <minus/>
                        <ci>vj2</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qout3</ci>
                <apply>
                    <times/>
                    <ci>w_out3</ci>
                    <apply>
                        <minus/>
                        <ci>vj3</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qout4</ci>
                <apply>
                    <times/>
                    <ci>w_out4</ci>
                    <apply>
                        <minus/>
                        <ci>vj4</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="Qin_tot" public_interface="out" units="m3_per_s"/>
        <variable name="Qout_tot" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Qin_tot</ci>
                <apply>
                    <plus/>
                    <ci>Qin1</ci>
                    <ci>Qin2</ci>
                    <ci>Qin3</ci>
                    <ci>Qin4</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Qout_tot</ci>
                <apply>
                    <plus/>
                    <ci>Qout1</ci>
                    <ci>Qout2</ci>
                    <ci>Qout3</ci>
                    <ci>Qout4</ci>
                </apply>
            </apply>
        </math>
        <variable name="bc1_is_in" public_interface="out" units="dimensionless"/>
        <variable name="bc2_is_in" public_interface="out" units="dimensionless"/>
        <variable name="bc3_is_in" public_interface="out" units="dimensionless"/>
        <variable name="bc4_is_in" public_interface="out" units="dimensionless"/>
        <variable name="bc1_is_out" public_interface="out" units="dimensionless"/>
        <variable name="bc2_is_out" public_interface="out" units="dimensionless"/>
        <variable name="bc3_is_out" public_interface="out" units="dimensionless"/>
        <variable name="bc4_is_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>bc1_is_in</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qin1</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc2_is_in</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qin2</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc3_is_in</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qin3</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc4_is_in</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qin4</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc1_is_out</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qout1</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc2_is_out</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qout2</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc3_is_out</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qout3</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>bc4_is_out</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>Qout4</ci>
                            <ci>v_threshold</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="n_in" public_interface="out" units="dimensionless"/>
        <variable name="n_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>n_in</ci>
                <apply>
                    <plus/>
                    <ci>bc1_is_in</ci>
                    <ci>bc2_is_in</ci>
                    <ci>bc3_is_in</ci>
                    <ci>bc4_is_in</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>n_out</ci>
                <apply>
                    <plus/>
                    <ci>bc1_is_out</ci>
                    <ci>bc2_is_out</ci>
                    <ci>bc3_is_out</ci>
                    <ci>bc4_is_out</ci>
                </apply>
            </apply>
        </math>
        <!-- junction_type: +1 split (1 feeder), -1 merge (>=2 feeders), 0 other/degenerate-->
        <variable name="junction_type" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>junction_type</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <eq/>
                            <ci>n_in</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                        <apply>
                            <geq/>
                            <ci>n_in</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;- junction mode flags derived from your junction_type &#45;&#45;- -->
        <variable name="is_split" public_interface="out" units="dimensionless"/>
        <variable name="is_merge" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>is_split</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <eq/>
                            <ci>junction_type</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>is_merge</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <eq/>
                            <ci>junction_type</ci>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; pick FEED port in split: the largest Qin (ties broken 1->2->3->4) &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="feed1" public_interface="out" units="dimensionless"/>
        <variable name="feed2" public_interface="out" units="dimensionless"/>
        <variable name="feed3" public_interface="out" units="dimensionless"/>
        <variable name="feed4" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>feed1</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin1</ci>
                                <ci>Qin2</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin1</ci>
                                <ci>Qin3</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin1</ci>
                                <ci>Qin4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>feed2</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin2</ci>
                                <ci>Qin1</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin2</ci>
                                <ci>Qin3</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin2</ci>
                                <ci>Qin4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>feed3</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin3</ci>
                                <ci>Qin1</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin3</ci>
                                <ci>Qin2</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qin3</ci>
                                <ci>Qin4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>feed4</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin4</ci>
                                <ci>Qin1</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin4</ci>
                                <ci>Qin2</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qin4</ci>
                                <ci>Qin3</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; alpha = daughter port with biggest Qout (ties 1->2->3->4) &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="alpha1" public_interface="out" units="dimensionless"/>
        <variable name="alpha2" public_interface="out" units="dimensionless"/>
        <variable name="alpha3" public_interface="out" units="dimensionless"/>
        <variable name="alpha4" public_interface="out" units="dimensionless"/>
        <!-- alpha1 if port1 is a daughter AND has >= Qout than others-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>alpha1</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc1_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout1</ci>
                                <ci>Qout2</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout1</ci>
                                <ci>Qout3</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout1</ci>
                                <ci>Qout4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <!-- alpha2 only if not alpha1 (tie-break) and port2 is a daughter and beats remaining-->
            <apply>
                <eq/>
                <ci>alpha2</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc2_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout2</ci>
                                <ci>Qout1</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout2</ci>
                                <ci>Qout3</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout2</ci>
                                <ci>Qout4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>alpha3</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc3_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout3</ci>
                                <ci>Qout1</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout3</ci>
                                <ci>Qout2</ci>
                            </apply>
                            <apply>
                                <geq/>
                                <ci>Qout3</ci>
                                <ci>Qout4</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>alpha4</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc4_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout4</ci>
                                <ci>Qout1</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout4</ci>
                                <ci>Qout2</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>Qout4</ci>
                                <ci>Qout3</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="beta1" public_interface="out" units="dimensionless"/>
        <variable name="beta2" public_interface="out" units="dimensionless"/>
        <variable name="beta3" public_interface="out" units="dimensionless"/>
        <variable name="beta4" public_interface="out" units="dimensionless"/>
        <!-- beta among remaining daughters (ties 1->2->3->4), must be a daughter-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>beta1</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc1_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>alpha1</ci>
                                <cn cellml:units="dimensionless">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>beta2</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc2_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>alpha2</ci>
                                <cn cellml:units="dimensionless">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>beta3</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc3_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>alpha3</ci>
                                <cn cellml:units="dimensionless">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>beta4</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <and/>
                            <apply>
                                <eq/>
                                <ci>is_split</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>bc4_is_out</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <apply>
                                <eq/>
                                <ci>alpha4</ci>
                                <cn cellml:units="dimensionless">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="D_F" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>D_F</ci>
                <piecewise>
                    <piece>
                        <ci>D1</ci>
                        <apply>
                            <eq/>
                            <ci>feed1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D2</ci>
                        <apply>
                            <eq/>
                            <ci>feed2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D3</ci>
                        <apply>
                            <eq/>
                            <ci>feed3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D4</ci>
                        <apply>
                            <eq/>
                            <ci>feed4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>D1</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; D_alpha from which ALPHA port? &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="D_alpha" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>D_alpha</ci>
                <piecewise>
                    <piece>
                        <ci>D1</ci>
                        <apply>
                            <eq/>
                            <ci>alpha1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D2</ci>
                        <apply>
                            <eq/>
                            <ci>alpha2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D3</ci>
                        <apply>
                            <eq/>
                            <ci>alpha3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D4</ci>
                        <apply>
                            <eq/>
                            <ci>alpha4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>D3</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; D_beta from which BETA port? &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="D_beta" public_interface="out" units="metre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>D_beta</ci>
                <piecewise>
                    <piece>
                        <ci>D1</ci>
                        <apply>
                            <eq/>
                            <ci>beta1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D2</ci>
                        <apply>
                            <eq/>
                            <ci>beta2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D3</ci>
                        <apply>
                            <eq/>
                            <ci>beta3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>D4</ci>
                        <apply>
                            <eq/>
                            <ci>beta4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>D4</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45; daughter outflow magnitudes for alpha/beta &#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
        <variable name="v_alpha" public_interface="out" units="m3_per_s"/>
        <variable name="v_beta" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_alpha</ci>
                <piecewise>
                    <piece>
                        <ci>Qout1</ci>
                        <apply>
                            <eq/>
                            <ci>alpha1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout2</ci>
                        <apply>
                            <eq/>
                            <ci>alpha2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout3</ci>
                        <apply>
                            <eq/>
                            <ci>alpha3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout4</ci>
                        <apply>
                            <eq/>
                            <ci>alpha4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="m3_per_s">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>v_beta</ci>
                <piecewise>
                    <piece>
                        <ci>Qout1</ci>
                        <apply>
                            <eq/>
                            <ci>beta1</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout2</ci>
                        <apply>
                            <eq/>
                            <ci>beta2</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout3</ci>
                        <apply>
                            <eq/>
                            <ci>beta3</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <piece>
                        <ci>Qout4</ci>
                        <apply>
                            <eq/>
                            <ci>beta4</ci>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="m3_per_s">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <variable name="FQB_alpha" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>FQB_alpha</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <ci>v_alpha</ci>
                        <ci>div_0</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>v_alpha</ci>
                        <ci>v_beta</ci>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">2</cn>
                            <ci>div_0</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="FQE_alpha" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>FQE_alpha</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <minus/>
                                <apply>
                                    <plus/>
                                    <ci>A</ci>
                                    <apply>
                                        <times/>
                                        <ci>B</ci>
                                        <ci>ph</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="B" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>B</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">6.98</cn>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                                <ci>H_mean</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>D_F</ci>
                            <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="A" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>A</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">6.96</cn>
                        </apply>
                        <apply>
                            <ln/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>D_alpha</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>D_beta</ci>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>D_F</ci>
                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="X_0" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>X_0</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">0.4</cn>
                    <apply>
                        <times/>
                        <ci>D_F</ci>
                        <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="ph" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>ph</ci>
                <apply>
                    <ln/>
                    <apply>
                        <divide/>
                        <ci>y</ci>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>y</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="y_raw" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>y_raw</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>FQB_alpha</ci>
                        <ci>X_0</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">2</cn>
                                <ci>X_0</ci>
                            </apply>
                        </apply>
                        <ci>div_0</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="y" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>y</ci>
                <apply>
                    <min/>
                    <apply>
                        <max/>
                        <ci>y_raw</ci>
                        <ci>div_0y</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>div_0y</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--var epsilon_alpha: dimensionless {pub: out};-->
        <!--epsilon_alpha = H_VV_out_alpha-H_mean*FQE_alpha/(FQB_alpha+div_0);-->
        <variable name="H_VV_out_alpha" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_VV_out_alpha</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>H_mean</ci>
                        <ci>FQE_alpha</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>FQB_alpha</ci>
                        <ci>div_0</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--ode(H_VV_out_alpha, t) = is_split*-k*epsilon_alpha;-->
        <variable name="H_VV_out_beta" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_VV_out_beta</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>H_mean</ci>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>FQE_alpha</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>FQB_alpha</ci>
                        </apply>
                        <ci>div_0</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--////////////////////////////////VV_BG////////////////////////////////
////////////////////////////////////////////-->
        <variable name="RBC_in" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_in</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>Qin1</ci>
                        <ci>H_to1</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qin2</ci>
                        <ci>H_to2</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qin3</ci>
                        <ci>H_to3</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qin4</ci>
                        <ci>H_to4</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="RBC_out" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_out</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>Qout1</ci>
                        <ci>H_from1</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qout2</ci>
                        <ci>H_from2</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qout3</ci>
                        <ci>H_from3</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Qout4</ci>
                        <ci>H_from4</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- &#45;&#45;- stored RBC volume inside VV1 &#45;&#45;- -->
        <variable name="RBC_volume_init" public_interface="out" units="m3"/>
        <variable initial_value="1.27235130740022e-17" name="RBC_volume" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_init</ci>
                <apply>
                    <times/>
                    <ci>H_global_L</ci>
                    <ci>q_us</ci>
                </apply>
            </apply>
            <!-- mass balance-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RBC_volume</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>RBC_in</ci>
                    <ci>RBC_out</ci>
                </apply>
            </apply>
        </math>
        <!-- &#45;&#45;- mean VV1 hematocrit (concentration) &#45;&#45;- -->
        <variable name="H_mean" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_mean</ci>
                <apply>
                    <divide/>
                    <ci>RBC_volume</ci>
                    <apply>
                        <plus/>
                        <ci>q_us</ci>
                        <ci>div_0</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--/////////////////////////////setting junctional compliance to greatest compliance of the vessels connected to it -->
        <variable name="C_conn1" public_interface="in" units="m6_per_J"/>
        <variable name="C_conn2" public_interface="in" units="m6_per_J"/>
        <variable name="C_conn3" public_interface="in" units="m6_per_J"/>
        <variable name="C_conn4" public_interface="in" units="m6_per_J"/>
        <variable name="C_max12" public_interface="out" units="m6_per_J"/>
        <variable name="C_max123" public_interface="out" units="m6_per_J"/>
        <variable name="C" public_interface="out" units="m6_per_J"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>C_max12</ci>
                <piecewise>
                    <piece>
                        <ci>C_conn1</ci>
                        <apply>
                            <gt/>
                            <ci>C_conn1</ci>
                            <ci>C_conn2</ci>
                        </apply>
                    </piece>
                    <piece>
                        <ci>C_conn2</ci>
                        <apply>
                            <leq/>
                            <ci>C_conn1</ci>
                            <ci>C_conn2</ci>
                        </apply>
                    </piece>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>C_max123</ci>
                <piecewise>
                    <piece>
                        <ci>C_max12</ci>
                        <apply>
                            <gt/>
                            <ci>C_max12</ci>
                            <ci>C_conn3</ci>
                        </apply>
                    </piece>
                    <piece>
                        <ci>C_conn3</ci>
                        <apply>
                            <leq/>
                            <ci>C_max12</ci>
                            <ci>C_conn3</ci>
                        </apply>
                    </piece>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>C</ci>
                <piecewise>
                    <piece>
                        <ci>C_max123</ci>
                        <apply>
                            <gt/>
                            <ci>C_max123</ci>
                            <ci>C_conn4</ci>
                        </apply>
                    </piece>
                    <piece>
                        <ci>C_conn4</ci>
                        <apply>
                            <leq/>
                            <ci>C_max123</ci>
                            <ci>C_conn4</ci>
                        </apply>
                    </piece>
                </piecewise>
            </apply>
        </math>
        <variable initial_value="7.64204797509218e-19" name="q_C" public_interface="out" units="m3"/>
        <variable initial_value="7.64183299288611e-19" name="q_C_d" public_interface="out" units="m3"/>
        <variable name="q" public_interface="out" units="m3"/>
        <variable name="q_us" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q_us</ci>
                <apply>
                    <times/>
                    <pi/>
                    <apply>
                        <power/>
                        <ci>r</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <ci>l</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q</ci>
                <apply>
                    <plus/>
                    <ci>q_us</ci>
                    <ci>q_C</ci>
                    <ci>q_C_d</ci>
                </apply>
            </apply>
        </math>
        <variable name="R_VV_junc" public_interface="in" units="Js_per_m6"/>
        <!-- State Variables-->
        <variable name="u" public_interface="out" units="J_per_m3"/>
        <variable name="u_mmHg" public_interface="out" units="dimensionless"/>
        <variable name="v" public_interface="out" units="m3_per_s"/>
        <variable name="v_mm3_s" public_interface="out" units="mm3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_mm3_s</ci>
                <apply>
                    <divide/>
                    <ci>v</ci>
                    <ci>one_mm3</ci>
                </apply>
            </apply>
        </math>
        <variable name="u_d" public_interface="out" units="J_per_m3"/>
        <variable name="u_d_mmHg" public_interface="out" units="dimensionless"/>
        <!-- Conservation Laws
question?????????? whether ode (q_c and q_C_d) should be vbc1-4 or vj1-4-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>u</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <ci>q_C</ci>
                        <apply>
                            <divide/>
                            <ci>C</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                    <ci>u_ext</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_C</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <ci>vbc1</ci>
                        <ci>vbc2</ci>
                    </apply>
                    <ci>v</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_mmHg</ci>
                <apply>
                    <divide/>
                    <ci>u</ci>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u</ci>
                        <ci>u_d</ci>
                    </apply>
                    <ci>R_VV_junc</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_d</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <ci>q_C_d</ci>
                        <apply>
                            <divide/>
                            <ci>C</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                    <ci>u_ext</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_C_d</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>v</ci>
                        <ci>vbc3</ci>
                    </apply>
                    <ci>vbc4</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_d_mmHg</ci>
                <apply>
                    <divide/>
                    <ci>u_d</ci>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
        </math>
    </component>
    <!-- inlined from switching_test_modules.cellml -->
    <component name="V3_module">
        <!--import variables-->
        <variable name="t" public_interface="in" units="second"/>
        <variable name="H_global_L" public_interface="in" units="dimensionless"/>
        <variable name="H_global_R" public_interface="in" units="dimensionless"/>
        <variable name="H_L_out_RHS" public_interface="in" units="dimensionless"/>
        <variable name="H_R_out_LHS" public_interface="in" units="dimensionless"/>
        <variable name="gamma_mirror" public_interface="in" units="dimensionless"/>
        <variable name="tau_H_down" public_interface="in" units="second"/>
        <variable name="tau_H_mean" public_interface="in" units="second"/>
        <!--0.001-->
        <variable name="v_eps" public_interface="in" units="m3_per_s"/>
        <variable name="q_C_init" public_interface="in" units="m3"/>
        <!--0-->
        <variable name="l" public_interface="in" units="metre"/>
        <variable name="r" public_interface="in" units="metre"/>
        <variable name="mu_plasma" public_interface="in" units="Js_per_m3"/>
        <variable name="u_in" public_interface="in" units="J_per_m3"/>
        <variable name="u_ext" public_interface="in" units="J_per_m3"/>
        <variable name="u_out" public_interface="in" units="J_per_m3"/>
        <variable name="tau_link" public_interface="in" units="second"/>
        <variable name="v_scale" public_interface="in" units="m3_per_s"/>
        <variable name="one_mm3" public_interface="in" units="m3"/>
        <variable name="w_v" public_interface="out" units="dimensionless"/>
        <variable name="w_v_d" public_interface="out" units="dimensionless"/>
        <!--w_v   = 0.5{dimensionless}+1{dimensionless}/pi*atan(v/v_scale);-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_v</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>v</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <piece>
                        <cn cellml:units="dimensionless">0</cn>
                        <apply>
                            <lt/>
                            <ci>v</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0.5</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <!--w_v_d = 0.5{dimensionless}+1{dimensionless}/pi*atan(v_d/v_scale);-->
            <apply>
                <eq/>
                <ci>w_v_d</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <gt/>
                            <ci>v_d</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <piece>
                        <cn cellml:units="dimensionless">0</cn>
                        <apply>
                            <lt/>
                            <ci>v_d</ci>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0.5</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!--/////////////////////////coupling with RHS vessel using ode to break 
instaneous coupling requirement/////////-->
        <variable name="H_link_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_R</ci>
                <ci>H_L_out_RHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_link_L" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_link_L</ci>
                <ci>H_R_out_LHS</ci>
            </apply>
        </math>
        <!--RHS means RHS vessel-->
        <variable name="H_L_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_in</ci>
                <ci>H_link_L</ci>
            </apply>
        </math>
        <variable name="H_R_in" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_R_in</ci>
                <ci>H_link_R</ci>
            </apply>
        </math>
        <variable name="H_up" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_up</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v_d</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v_d</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="0.450002281977362" name="H_down" public_interface="out" units="dimensionless"/>
        <variable name="H_down_target" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_down_target</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>s_v_d</ci>
                        <apply>
                            <plus/>
                            <ci>H_mean</ci>
                            <apply>
                                <times/>
                                <ci>gamma_mirror</ci>
                                <apply>
                                    <minus/>
                                    <ci>H_mean</ci>
                                    <ci>H_up</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>s_v_d</ci>
                        </apply>
                        <ci>H_mean</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>H_down</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>H_down_target</ci>
                        <ci>H_down</ci>
                    </apply>
                    <ci>tau_H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="s_v_d" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>s_v_d</ci>
                <apply>
                    <divide/>
                    <apply>
                        <abs/>
                        <ci>v_d</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <abs/>
                            <ci>v_d</ci>
                        </apply>
                        <ci>v_eps</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--/useful when flow =0, if 0, make H_down=H_mean-->
        <variable name="H_L_out" public_interface="out" units="dimensionless"/>
        <variable name="H_R_out" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>H_L_out</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>w_v_d</ci>
                    </apply>
                    <ci>H_down</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>H_R_out</ci>
                <apply>
                    <times/>
                    <ci>w_v_d</ci>
                    <ci>H_down</ci>
                </apply>
            </apply>
        </math>
        <variable name="v_RBC" public_interface="out" units="m3_per_s"/>
        <variable name="v_d_RBC" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.37</cn>
                    <ci>v</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_d_RBC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">1.37</cn>
                    <ci>v_d</ci>
                </apply>
            </apply>
        </math>
        <variable initial_value="1.27280547241853e-15" name="RBC_volume" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RBC_volume</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>v_RBC</ci>
                        <ci>RBC_volume_L</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>v_d_RBC</ci>
                        <ci>RBC_volume_R</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable name="RBC_volume_init" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_init</ci>
                <apply>
                    <times/>
                    <ci>H_global_L</ci>
                    <ci>q_us</ci>
                </apply>
            </apply>
            <!--pos/neg for RBC mass conservation only-->
            <!-- inflow from right (v_d<0)-->
            <!--var H_target: dimensionless {pub: out};-->
            <!--H_target = RBC_volume/q;-->
            <apply>
                <eq/>
                <ci>H_mean</ci>
                <apply>
                    <divide/>
                    <ci>RBC_volume</ci>
                    <ci>q</ci>
                </apply>
            </apply>
        </math>
        <variable name="H_mean" public_interface="out" units="dimensionless"/>
        <!--ode(H_mean, t) = (H_target-H_mean)/tau_H_mean;-->
        <variable name="RBC_volume_L" public_interface="out" units="dimensionless"/>
        <variable name="RBC_volume_R" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>RBC_volume_L</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v</ci>
                        <ci>H_L_in</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v</ci>
                        </apply>
                        <ci>H_L_out</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>RBC_volume_R</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w_v_d</ci>
                        <ci>H_R_out</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>w_v_d</ci>
                        </apply>
                        <ci>H_R_in</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--//////////////-->
        <variable initial_value="1.00888250894794e-18" name="q_C" public_interface="out" units="m3"/>
        <variable name="q" public_interface="out" units="m3"/>
        <variable name="q_us" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q_us</ci>
                <apply>
                    <times/>
                    <pi/>
                    <apply>
                        <power/>
                        <ci>r</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <ci>l</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q</ci>
                <apply>
                    <plus/>
                    <ci>q_us</ci>
                    <ci>q_C</ci>
                </apply>
            </apply>
        </math>
        <variable name="C" public_interface="out" units="m6_per_J"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>C</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <pi/>
                        <apply>
                            <power/>
                            <cn cellml:units="metre" type="e-notation">8.5<sep/>-9</cn>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                        <ci>l</ci>
                    </apply>
                    <cn cellml:units="J_per_m3">133.322</cn>
                </apply>
            </apply>
        </math>
        <variable name="Z" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Z</ci>
                <apply>
                    <plus/>
                    <apply>
