                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <gt/>
                <ci>Qin4</ci>
                <ci>Qin1</ci>
              </apply>
              <apply>
                <gt/>
                <ci>Qin4</ci>
                <ci>Qin2</ci>
              </apply>
              <apply>
                <gt/>
                <ci>Qin4</ci>
                <ci>Qin3</ci>
              </apply>
            </apply>
          </piece>
          <otherwise>
