            </apply>
          </piece>
          <otherwise>
            <ci>H_to4</ci>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>H_from1_target</ci>
        <piecewise>
          <piece>
            <ci>H_daughter1</ci>
            <apply>
              <eq/>
              <ci>bc1_is_out</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to1</ci>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_from2_target</ci>
        <piecewise>
          <piece>
            <ci>H_daughter2</ci>
            <apply>
