            <cn cellml:units="m3_per_s">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>v_beta</ci>
        <piecewise>
          <piece>
            <ci>Qout1</ci>
            <apply>
              <eq/>
              <ci>beta1</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>Qout2</ci>
            <apply>
              <eq/>
              <ci>beta2</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>Qout3</ci>
            <apply>
              <eq/>
              <ci>beta3</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>Qout4</ci>
            <apply>
              <eq/>
              <ci>beta4</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="m3_per_s">0</cn>
          </otherwise>
