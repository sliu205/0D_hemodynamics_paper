          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>RBC_volume</ci>
        </apply>
        <apply>
          <minus/>
          <apply>
            <times/>
            <ci>v_RBC</ci>
            <ci>RBC_volume_L</ci>
          </apply>
          <apply>
            <times/>
            <ci>v_d_RBC</ci>
            <ci>RBC_volume_R</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>RBC_volume_init</ci>
        <apply>
          <times/>
          <ci>H_global_L</ci>
          <ci>q_us</ci>
        </apply>
      </apply>
      <!--var H_target: dimensionless {pub: out};-->
      <!--H_target = RBC_volume/q;-->
      <apply>
        <eq/>
        <ci>H_mean</ci>
        <apply>
          <divide/>
          <ci>RBC_volume</ci>
          <ci>q</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>RBC_volume_L</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>w_v</ci>
            <ci>H_L_in</ci>
          </apply>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>w_v</ci>
            </apply>
            <ci>H_L_out</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>RBC_volume_R</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>w_v</ci>
            <ci>H_R_out</ci>
          </apply>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>w_v</ci>
            </apply>
            <ci>H_R_in</ci>
          </apply>
        </apply>
      </apply>
