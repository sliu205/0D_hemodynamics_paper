          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_from2_target</ci>
        <piecewise>
          <piece>
            <ci>H_daughter2</ci>
            <apply>
              <eq/>
              <ci>bc2_is_out</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to2</ci>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_from3_target</ci>
        <piecewise>
          <piece>
            <ci>H_daughter3</ci>
            <apply>
              <eq/>
              <ci>bc3_is_out</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to3</ci>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_from4_target</ci>
        <piecewise>
          <piece>
            <ci>H_daughter4</ci>
            <apply>
              <eq/>
              <ci>bc4_is_out</ci>
