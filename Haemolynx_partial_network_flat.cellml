    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>Qin1</ci>
        <apply>
          <times/>
          <ci>w_in1</ci>
          <ci>vj1</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Qin2</ci>
        <apply>
          <times/>
          <ci>w_in2</ci>
          <ci>vj2</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Qin3</ci>
        <apply>
          <times/>
          <ci>w_in3</ci>
          <ci>vj3</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Qin4</ci>
        <apply>
          <times/>
          <ci>w_in4</ci>
          <ci>vj4</ci>
        </apply>
      </apply>
      <!--absolute (magnitude) of flow out of the junction-->
      <apply>
        <eq/>
        <ci>Qout1</ci>
        <apply>
          <times/>
          <ci>w_out1</ci>
          <apply>
            <minus/>
            <ci>vj1</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Qout2</ci>
        <apply>
          <times/>
          <ci>w_out2</ci>
          <apply>
            <minus/>
            <ci>vj2</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Qout3</ci>
        <apply>
          <times/>
          <ci>w_out3</ci>
          <apply>
            <minus/>
            <ci>vj3</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Qout4</ci>
        <apply>
          <times/>
          <ci>w_out4</ci>
          <apply>
            <minus/>
            <ci>vj4</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>Qin_tot</ci>
        <apply>
          <plus/>
          <ci>Qin1</ci>
          <ci>Qin2</ci>
          <ci>Qin3</ci>
          <ci>Qin4</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Qout_tot</ci>
        <apply>
          <plus/>
          <ci>Qout1</ci>
          <ci>Qout2</ci>
          <ci>Qout3</ci>
          <ci>Qout4</ci>
        </apply>
