    <variable name="vbc2" units="m3_per_s" interface="public"/>
    <variable name="vbc3" units="m3_per_s" interface="public"/>
    <variable name="vbc4" units="m3_per_s" interface="public"/>
    <variable name="vj1" units="m3_per_s" interface="public"/>
    <variable name="vj2" units="m3_per_s" interface="public"/>
    <variable name="vj3" units="m3_per_s" interface="public"/>
    <variable name="vj4" units="m3_per_s" interface="public"/>
