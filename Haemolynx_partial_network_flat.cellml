            </apply>
          </piece>
          <otherwise>
            <ci>H_to2</ci>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_daughter3</ci>
        <piecewise>
          <piece>
            <ci>H_mean</ci>
            <apply>
