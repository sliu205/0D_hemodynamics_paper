      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>v_mm3_s</ci>
        <apply>
          <divide/>
          <ci>v</ci>
          <ci>one_mm3</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>u</ci>
            <ci>u_out</ci>
          </apply>
          <ci>R</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>u_mmHg</ci>
        <apply>
          <divide/>
          <ci>u</ci>
          <cn cellml:units="J_per_m3">133.322</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <ci>q_C</ci>
            <ci>C</ci>
          </apply>
          <ci>u_ext</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v_in</ci>
          <ci>v</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="V11_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="H_global_L" units="dimensionless" interface="public"/>
    <variable name="H_global_R" units="dimensionless" interface="public"/>
