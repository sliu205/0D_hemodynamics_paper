        <piecewise>
          <piece>
            <ci>Qout1</ci>
            <apply>
              <eq/>
              <ci>alpha1</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>Qout2</ci>
