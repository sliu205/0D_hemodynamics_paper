    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>stall_target</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <and/>
              <apply>
                <geq/>
                <ci>t</ci>
                <ci>t0</ci>
              </apply>
              <apply>
                <lt/>
                <ci>r_m</ci>
                <ci>r_thresh</ci>
              </apply>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>stall_memory</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>stall_target</ci>
            <ci>stall_memory</ci>
          </apply>
          <ci>tau_stall</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>stall</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <gt/>
              <ci>stall_memory</ci>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0</cn>
          </otherwise>
        </piecewise>
      </apply>
    </math>
