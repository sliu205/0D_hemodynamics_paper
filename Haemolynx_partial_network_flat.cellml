              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>Qout2</ci>
            <apply>
              <eq/>
              <ci>alpha2</ci>
              <cn cellml:units="dimensionless">1</cn>
