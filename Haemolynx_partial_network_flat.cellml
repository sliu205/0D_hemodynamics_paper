            <plus/>
            <ci>v_alpha</ci>
            <ci>div_0</ci>
          </apply>
          <apply>
            <plus/>
            <ci>v_alpha</ci>
            <ci>v_beta</ci>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">2</cn>
