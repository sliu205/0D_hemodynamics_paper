      <apply>
        <eq/>
        <ci>alpha</ci>
        <apply>
          <plus/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <times/>
            <apply>
              <minus/>
              <ci>alpha_max</ci>
