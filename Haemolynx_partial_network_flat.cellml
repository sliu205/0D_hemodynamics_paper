            <apply>
              <ln/>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <ci>D_alpha</ci>
                  <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                </apply>
                <apply>
                  <times/>
                  <ci>D_beta</ci>
