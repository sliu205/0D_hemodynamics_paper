              </apply>
              <apply>
                <eq/>
                <ci>bc3_is_out</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <gt/>
                <ci>Qout3</ci>
                <ci>Qout1</ci>
              </apply>
              <apply>
                <gt/>
                <ci>Qout3</ci>
                <ci>Qout2</ci>
              </apply>
              <apply>
                <geq/>
                <ci>Qout3</ci>
                <ci>Qout4</ci>
              </apply>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>alpha4</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <and/>
              <apply>
                <eq/>
                <ci>is_split</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <eq/>
                <ci>bc4_is_out</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <gt/>
                <ci>Qout4</ci>
                <ci>Qout1</ci>
              </apply>
              <apply>
                <gt/>
                <ci>Qout4</ci>
                <ci>Qout2</ci>
              </apply>
              <apply>
                <gt/>
                <ci>Qout4</ci>
                <ci>Qout3</ci>
              </apply>
            </apply>
          </piece>
          <otherwise>
