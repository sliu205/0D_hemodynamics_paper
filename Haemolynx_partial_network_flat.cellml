    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>FQB_alpha</ci>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <ci>v_alpha</ci>
            <ci>div_0</ci>
          </apply>
          <apply>
            <plus/>
            <ci>v_alpha</ci>
            <ci>v_beta</ci>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">2</cn>
              <ci>div_0</ci>
            </apply>
          </apply>
        </apply>
      </apply>
