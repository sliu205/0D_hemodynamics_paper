    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>n_in</ci>
        <apply>
          <plus/>
          <ci>bc1_is_in</ci>
          <ci>bc2_is_in</ci>
          <ci>bc3_is_in</ci>
          <ci>bc4_is_in</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>n_out</ci>
        <apply>
          <plus/>
