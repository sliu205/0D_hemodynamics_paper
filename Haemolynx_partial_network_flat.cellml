    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>RBC_volume_init</ci>
        <apply>
          <times/>
          <ci>H_global_L</ci>
          <ci>q_us</ci>
        </apply>
      </apply>
      <!-- mass balance-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>RBC_volume</ci>
        </apply>
        <apply>
