    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>H_from1</ci>
        <apply>
          <times/>
          <ci>w_out1</ci>
          <ci>H_from1_target</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>H_from2</ci>
        <apply>
          <times/>
          <ci>w_out2</ci>
          <ci>H_from2_target</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>H_from3</ci>
        <apply>
          <times/>
          <ci>w_out3</ci>
          <ci>H_from3_target</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
