    <variable name="Qout2" units="m3_per_s" interface="public"/>
    <variable name="Qout3" units="m3_per_s" interface="public"/>
    <variable name="Qout4" units="m3_per_s" interface="public"/>
    <variable name="Qin_tot" units="m3_per_s" interface="public"/>
    <variable name="Qout_tot" units="m3_per_s" interface="public"/>
