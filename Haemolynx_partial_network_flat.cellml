        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <ci>A</ci>
                  <apply>
                    <times/>
                    <ci>B</ci>
                    <ci>ph</ci>
