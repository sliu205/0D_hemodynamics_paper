            <apply>
              <gt/>
              <ci>Qout1</ci>
              <ci>v_threshold</ci>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>bc2_is_out</ci>
        <piecewise>
