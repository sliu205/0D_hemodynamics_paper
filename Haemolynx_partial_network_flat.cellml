            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>w_in3</ci>
        <apply>
          <plus/>
          <cn cellml:units="dimensionless">0.5</cn>
          <apply>
            <times/>
            <apply>
              <divide/>
