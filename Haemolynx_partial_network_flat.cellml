              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>D3</ci>
            <apply>
              <eq/>
              <ci>feed3</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>D4</ci>
            <apply>
              <eq/>
              <ci>feed4</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>D1</ci>
          </otherwise>
        </piecewise>
