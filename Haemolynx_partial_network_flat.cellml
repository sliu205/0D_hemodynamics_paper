      <apply>
        <eq/>
        <ci>beta4</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <and/>
              <apply>
                <eq/>
                <ci>is_split</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <eq/>
                <ci>bc4_is_out</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
