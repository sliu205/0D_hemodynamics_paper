      <apply>
        <eq/>
        <ci>y</ci>
        <apply>
          <min/>
          <apply>
            <max/>
            <ci>y_raw</ci>
            <ci>div_0y</ci>
          </apply>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
