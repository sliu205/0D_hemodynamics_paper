                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <geq/>
                <ci>Qin1</ci>
                <ci>Qin2</ci>
              </apply>
              <apply>
                <geq/>
                <ci>Qin1</ci>
                <ci>Qin3</ci>
              </apply>
              <apply>
                <geq/>
                <ci>Qin1</ci>
                <ci>Qin4</ci>
              </apply>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>feed2</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <and/>
              <apply>
                <eq/>
                <ci>is_split</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <gt/>
                <ci>Qin2</ci>
                <ci>Qin1</ci>
              </apply>
              <apply>
                <geq/>
                <ci>Qin2</ci>
                <ci>Qin3</ci>
              </apply>
              <apply>
                <geq/>
                <ci>Qin2</ci>
                <ci>Qin4</ci>
              </apply>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>feed3</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <and/>
              <apply>
                <eq/>
                <ci>is_split</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <gt/>
                <ci>Qin3</ci>
                <ci>Qin1</ci>
              </apply>
              <apply>
                <gt/>
                <ci>Qin3</ci>
                <ci>Qin2</ci>
              </apply>
              <apply>
                <geq/>
                <ci>Qin3</ci>
                <ci>Qin4</ci>
              </apply>
            </apply>
          </piece>
          <otherwise>
