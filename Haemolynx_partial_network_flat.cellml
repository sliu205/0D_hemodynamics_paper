    <variable name="alpha2" units="dimensionless" interface="public"/>
    <variable name="alpha3" units="dimensionless" interface="public"/>
    <variable name="alpha4" units="dimensionless" interface="public"/>
    <variable name="beta1" units="dimensionless" interface="public"/>
    <variable name="beta2" units="dimensionless" interface="public"/>
    <variable name="beta3" units="dimensionless" interface="public"/>
    <variable name="beta4" units="dimensionless" interface="public"/>
    <variable name="D_F" units="metre" interface="public"/>
    <variable name="D_alpha" units="metre" interface="public"/>
    <variable name="D_beta" units="metre" interface="public"/>
    <variable name="v_alpha" units="m3_per_s" interface="public"/>
    <variable name="v_beta" units="m3_per_s" interface="public"/>
    <variable name="FQB_alpha" units="dimensionless" interface="public"/>
    <variable name="FQE_alpha" units="dimensionless" interface="public"/>
    <variable name="B" units="dimensionless" interface="public"/>
    <variable name="A" units="dimensionless" interface="public"/>
    <variable name="X_0" units="dimensionless" interface="public"/>
    <variable name="ph" units="dimensionless" interface="public"/>
    <variable name="y_raw" units="dimensionless" interface="public"/>
    <variable name="y" units="dimensionless" interface="public"/>
    <variable name="H_VV_out_alpha" units="dimensionless" interface="public"/>
    <variable name="H_VV_out_beta" units="dimensionless" interface="public"/>
    <variable name="RBC_in" units="m3_per_s" interface="public"/>
    <variable name="RBC_out" units="m3_per_s" interface="public"/>
    <variable name="RBC_volume_init" units="m3" interface="public"/>
    <variable name="RBC_volume" units="m3" initial_value="RBC_volume_init" interface="public"/>
    <variable name="H_mean" units="dimensionless" interface="public"/>
    <variable name="C_conn1" units="m6_per_J" interface="public"/>
    <variable name="C_conn2" units="m6_per_J" interface="public"/>
    <variable name="C_conn3" units="m6_per_J" interface="public"/>
    <variable name="C_conn4" units="m6_per_J" interface="public"/>
    <variable name="C_max12" units="m6_per_J" interface="public"/>
    <variable name="C_max123" units="m6_per_J" interface="public"/>
    <variable name="C" units="m6_per_J" interface="public"/>
    <variable name="q_C" units="m3" initial_value="q_C_init" interface="public"/>
    <variable name="q_C_d" units="m3" initial_value="q_C_init" interface="public"/>
    <variable name="q" units="m3" interface="public"/>
    <variable name="q_us" units="m3" interface="public"/>
    <variable name="R_VV_junc" units="Js_per_m6" interface="public"/>
    <variable name="u" units="J_per_m3" interface="public"/>
    <variable name="u_mmHg" units="dimensionless" interface="public"/>
    <variable name="v" units="m3_per_s" interface="public"/>
    <variable name="v_mm3_s" units="mm3_per_s" interface="public"/>
    <variable name="u_d" units="J_per_m3" interface="public"/>
    <variable name="u_d_mmHg" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>vj1</ci>
        <ci>vbc1</ci>
      </apply>
      <apply>
        <eq/>
        <ci>vj2</ci>
        <ci>vbc2</ci>
      </apply>
      <apply>
        <eq/>
        <ci>vj3</ci>
        <apply>
          <minus/>
          <ci>vbc3</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>vj4</ci>
        <apply>
          <minus/>
          <ci>vbc4</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>H_split1</ci>
        <piecewise>
          <piece>
            <ci>H_VV_out_alpha</ci>
            <apply>
              <eq/>
              <ci>alpha1</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>H_VV_out_beta</ci>
            <apply>
              <eq/>
              <ci>beta1</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to1</ci>
          </otherwise>
        </piecewise>
      </apply>
      <!-- not a split-daughter =>unchanged-->
      <apply>
        <eq/>
        <ci>H_split2</ci>
        <piecewise>
          <piece>
            <ci>H_VV_out_alpha</ci>
            <apply>
              <eq/>
              <ci>alpha2</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>H_VV_out_beta</ci>
            <apply>
              <eq/>
              <ci>beta2</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to2</ci>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_split3</ci>
        <piecewise>
          <piece>
            <ci>H_VV_out_alpha</ci>
            <apply>
              <eq/>
              <ci>alpha3</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>H_VV_out_beta</ci>
            <apply>
              <eq/>
              <ci>beta3</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to3</ci>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_split4</ci>
        <piecewise>
          <piece>
            <ci>H_VV_out_alpha</ci>
            <apply>
              <eq/>
              <ci>alpha4</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>H_VV_out_beta</ci>
            <apply>
              <eq/>
              <ci>beta4</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to4</ci>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>H_daughter1</ci>
        <piecewise>
          <piece>
            <ci>H_mean</ci>
            <apply>
              <eq/>
              <ci>is_merge</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>H_split1</ci>
            <apply>
              <eq/>
              <ci>is_split</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to1</ci>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_daughter2</ci>
        <piecewise>
          <piece>
            <ci>H_mean</ci>
            <apply>
              <eq/>
              <ci>is_merge</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>H_split2</ci>
            <apply>
              <eq/>
              <ci>is_split</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to2</ci>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_daughter3</ci>
        <piecewise>
          <piece>
            <ci>H_mean</ci>
            <apply>
              <eq/>
              <ci>is_merge</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>H_split3</ci>
            <apply>
              <eq/>
              <ci>is_split</ci>
