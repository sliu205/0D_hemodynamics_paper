            <ci>stall_target</ci>
            <ci>stall_memory</ci>
          </apply>
          <ci>tau_stall</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>stall</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <gt/>
              <ci>stall_memory</ci>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0</cn>
          </otherwise>
        </piecewise>
      </apply>
    </math>
