            </apply>
          </piece>
          <otherwise>
            <ci>H_to3</ci>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>H_daughter4</ci>
        <piecewise>
          <piece>
            <ci>H_mean</ci>
            <apply>
              <eq/>
              <ci>is_merge</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>H_split4</ci>
            <apply>
