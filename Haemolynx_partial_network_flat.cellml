    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>H_mean</ci>
        <apply>
          <divide/>
          <ci>RBC_volume</ci>
          <apply>
            <plus/>
            <ci>q_us</ci>
            <ci>div_0</ci>
          </apply>
        </apply>
      </apply>
