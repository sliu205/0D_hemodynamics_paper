      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>FQB_alpha</ci>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <ci>v_alpha</ci>
            <ci>div_0</ci>
          </apply>
          <apply>
            <plus/>
            <ci>v_alpha</ci>
            <ci>v_beta</ci>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">2</cn>
              <ci>div_0</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>FQE_alpha</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <ci>A</ci>
                  <apply>
                    <times/>
                    <ci>B</ci>
                    <ci>ph</ci>
                  </apply>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>B</ci>
        <apply>
          <plus/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <divide/>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">6.98</cn>
              <apply>
                <minus/>
                <cn cellml:units="dimensionless">1</cn>
                <ci>H_mean</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>D_F</ci>
              <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>A</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">6.96</cn>
            </apply>
            <apply>
              <ln/>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <ci>D_alpha</ci>
                  <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                </apply>
                <apply>
                  <times/>
                  <ci>D_beta</ci>
                  <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                </apply>
              </apply>
            </apply>
          </apply>
          <apply>
            <times/>
            <ci>D_F</ci>
            <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>X_0</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">0.4</cn>
          <apply>
            <times/>
            <ci>D_F</ci>
            <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>ph</ci>
        <apply>
          <ln/>
          <apply>
            <divide/>
            <ci>y</ci>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>y</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>y_raw</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>FQB_alpha</ci>
            <ci>X_0</ci>
          </apply>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <times/>
                <cn cellml:units="dimensionless">2</cn>
                <ci>X_0</ci>
              </apply>
            </apply>
            <ci>div_0</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>y</ci>
        <apply>
          <min/>
          <apply>
            <max/>
            <ci>y_raw</ci>
            <ci>div_0y</ci>
          </apply>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
            <ci>div_0y</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>H_VV_out_alpha</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>H_mean</ci>
            <ci>FQE_alpha</ci>
          </apply>
          <apply>
            <plus/>
            <ci>FQB_alpha</ci>
            <ci>div_0</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>H_VV_out_beta</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>H_mean</ci>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>FQE_alpha</ci>
            </apply>
          </apply>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>FQB_alpha</ci>
            </apply>
            <ci>div_0</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>RBC_in</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>Qin1</ci>
            <ci>H_to1</ci>
          </apply>
          <apply>
            <times/>
            <ci>Qin2</ci>
            <ci>H_to2</ci>
          </apply>
          <apply>
            <times/>
            <ci>Qin3</ci>
            <ci>H_to3</ci>
          </apply>
          <apply>
            <times/>
            <ci>Qin4</ci>
            <ci>H_to4</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>RBC_out</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>Qout1</ci>
            <ci>H_from1</ci>
          </apply>
          <apply>
            <times/>
            <ci>Qout2</ci>
            <ci>H_from2</ci>
          </apply>
          <apply>
            <times/>
            <ci>Qout3</ci>
            <ci>H_from3</ci>
          </apply>
          <apply>
            <times/>
            <ci>Qout4</ci>
            <ci>H_from4</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>RBC_volume_init</ci>
        <apply>
          <times/>
          <ci>H_global_L</ci>
          <ci>q_us</ci>
        </apply>
      </apply>
      <!-- mass balance-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>RBC_volume</ci>
        </apply>
        <apply>
          <minus/>
          <ci>RBC_in</ci>
          <ci>RBC_out</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>H_mean</ci>
        <apply>
          <divide/>
          <ci>RBC_volume</ci>
          <apply>
            <plus/>
            <ci>q_us</ci>
            <ci>div_0</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>C_max12</ci>
        <piecewise>
          <piece>
            <ci>C_conn1</ci>
            <apply>
              <gt/>
              <ci>C_conn1</ci>
              <ci>C_conn2</ci>
            </apply>
          </piece>
          <piece>
            <ci>C_conn2</ci>
            <apply>
              <leq/>
              <ci>C_conn1</ci>
              <ci>C_conn2</ci>
            </apply>
          </piece>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>C_max123</ci>
        <piecewise>
          <piece>
            <ci>C_max12</ci>
            <apply>
              <gt/>
              <ci>C_max12</ci>
              <ci>C_conn3</ci>
            </apply>
          </piece>
          <piece>
            <ci>C_conn3</ci>
            <apply>
              <leq/>
              <ci>C_max12</ci>
              <ci>C_conn3</ci>
            </apply>
          </piece>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>C</ci>
        <piecewise>
          <piece>
            <ci>C_max123</ci>
            <apply>
              <gt/>
              <ci>C_max123</ci>
              <ci>C_conn4</ci>
            </apply>
          </piece>
          <piece>
            <ci>C_conn4</ci>
            <apply>
              <leq/>
              <ci>C_max123</ci>
              <ci>C_conn4</ci>
            </apply>
          </piece>
        </piecewise>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>q_us</ci>
        <apply>
          <times/>
          <pi/>
          <apply>
            <power/>
            <ci>r</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
          <ci>l</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q</ci>
        <apply>
          <plus/>
          <ci>q_us</ci>
          <ci>q_C</ci>
          <ci>q_C_d</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>v_mm3_s</ci>
        <apply>
          <divide/>
          <ci>v</ci>
          <ci>one_mm3</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <ci>q_C</ci>
            <apply>
              <divide/>
              <ci>C</ci>
              <cn cellml:units="dimensionless">2</cn>
            </apply>
          </apply>
          <ci>u_ext</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
          <minus/>
          <apply>
            <plus/>
            <ci>vbc1</ci>
            <ci>vbc2</ci>
          </apply>
          <ci>v</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_mmHg</ci>
        <apply>
          <divide/>
          <ci>u</ci>
          <cn cellml:units="J_per_m3">133.322</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>u</ci>
            <ci>u_d</ci>
          </apply>
          <ci>R_VV_junc</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_d</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <ci>q_C_d</ci>
            <apply>
              <divide/>
              <ci>C</ci>
              <cn cellml:units="dimensionless">2</cn>
            </apply>
          </apply>
          <ci>u_ext</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C_d</ci>
        </apply>
        <apply>
          <minus/>
          <apply>
            <minus/>
            <ci>v</ci>
            <ci>vbc3</ci>
          </apply>
          <ci>vbc4</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_d_mmHg</ci>
        <apply>
          <divide/>
          <ci>u_d</ci>
          <cn cellml:units="J_per_m3">133.322</cn>
        </apply>
      </apply>
    </math>
