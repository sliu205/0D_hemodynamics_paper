    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>FQB_alpha</ci>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <ci>v_alpha</ci>
            <ci>div_0</ci>
          </apply>
          <apply>
            <plus/>
            <ci>v_alpha</ci>
            <ci>v_beta</ci>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">2</cn>
              <ci>div_0</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>FQE_alpha</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <ci>A</ci>
                  <apply>
                    <times/>
                    <ci>B</ci>
                    <ci>ph</ci>
                  </apply>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>B</ci>
        <apply>
          <plus/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <divide/>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">6.98</cn>
              <apply>
                <minus/>
                <cn cellml:units="dimensionless">1</cn>
                <ci>H_mean</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>D_F</ci>
              <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>A</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">6.96</cn>
            </apply>
            <apply>
              <ln/>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <ci>D_alpha</ci>
                  <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                </apply>
                <apply>
                  <times/>
                  <ci>D_beta</ci>
                  <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                </apply>
              </apply>
            </apply>
          </apply>
          <apply>
            <times/>
            <ci>D_F</ci>
            <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
