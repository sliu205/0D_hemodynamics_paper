              <apply>
                <eq/>
                <ci>is_split</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <eq/>
                <ci>bc3_is_out</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <eq/>
                <ci>alpha3</ci>
