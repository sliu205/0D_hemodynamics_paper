                <ci>BOSF_Bx</ci>
              </apply>
              <ci>n</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <!--low_q              = 1{dimensionless}/(1{dimensionless}+pow(f_crit*abs(v)/v_base, n));-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
