    <variable name="u_mmHg" units="dimensionless" interface="public"/>
    <variable name="v_d" units="m3_per_s" interface="public"/>
    <variable name="v_d_mm3_s" units="mm3_per_s" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>w_v</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <gt/>
              <ci>v</ci>
              <cn cellml:units="dimensionless">0</cn>
            </apply>
          </piece>
          <piece>
            <cn cellml:units="dimensionless">0</cn>
            <apply>
              <lt/>
              <ci>v</ci>
              <cn cellml:units="dimensionless">0</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0.5</cn>
          </otherwise>
        </piecewise>
      </apply>
      <!--w_v_d = 0.5{dimensionless}+1{dimensionless}/pi*atan(v_d/v_scale);-->
      <apply>
        <eq/>
        <ci>w_v_d</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <gt/>
              <ci>v_d</ci>
              <cn cellml:units="dimensionless">0</cn>
            </apply>
          </piece>
          <piece>
            <cn cellml:units="dimensionless">0</cn>
            <apply>
              <lt/>
              <ci>v_d</ci>
              <cn cellml:units="dimensionless">0</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0.5</cn>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>H_link_R</ci>
        <ci>H_L_out_RHS</ci>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>H_link_L</ci>
        <ci>H_R_out_LHS</ci>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>H_L_in</ci>
        <ci>H_link_L</ci>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>H_R_in</ci>
        <ci>H_link_R</ci>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>H_up</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>w_v_d</ci>
            <ci>H_L_in</ci>
          </apply>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>w_v_d</ci>
            </apply>
            <ci>H_R_in</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>H_down_target</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>s_v_d</ci>
            <apply>
              <plus/>
              <ci>H_mean</ci>
              <apply>
                <times/>
                <ci>gamma_mirror</ci>
                <apply>
                  <minus/>
                  <ci>H_mean</ci>
                  <ci>H_up</ci>
                </apply>
              </apply>
            </apply>
          </apply>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>s_v_d</ci>
            </apply>
            <ci>H_mean</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>H_down</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>H_down_target</ci>
            <ci>H_down</ci>
          </apply>
          <ci>tau_H_down</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>s_v_d</ci>
        <apply>
          <divide/>
          <apply>
            <abs/>
            <ci>v_d</ci>
          </apply>
          <apply>
            <plus/>
            <apply>
              <abs/>
              <ci>v_d</ci>
            </apply>
            <ci>v_eps</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>H_L_out</ci>
        <apply>
          <times/>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
            <ci>w_v_d</ci>
          </apply>
          <ci>H_down</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>H_R_out</ci>
        <apply>
          <times/>
          <ci>w_v_d</ci>
          <ci>H_down</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>v_RBC</ci>
        <apply>
          <times/>
          <cn cellml:units="dimensionless">1.37</cn>
          <ci>v</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v_d_RBC</ci>
        <apply>
          <times/>
          <cn cellml:units="dimensionless">1.37</cn>
          <ci>v_d</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>RBC_volume</ci>
        </apply>
        <apply>
          <minus/>
          <apply>
            <times/>
            <ci>v_RBC</ci>
            <ci>RBC_volume_L</ci>
          </apply>
          <apply>
            <times/>
            <ci>v_d_RBC</ci>
            <ci>RBC_volume_R</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>RBC_volume_init</ci>
        <apply>
          <times/>
          <ci>H_global_L</ci>
          <ci>q_us</ci>
        </apply>
      </apply>
      <!--pos/neg for RBC mass conservation only-->
      <!-- inflow from right (v_d<0)-->
      <!--var H_target: dimensionless {pub: out};-->
      <!--H_target = RBC_volume/q;-->
      <apply>
        <eq/>
        <ci>H_mean</ci>
        <apply>
          <divide/>
          <ci>RBC_volume</ci>
          <ci>q</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>RBC_volume_L</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>w_v</ci>
            <ci>H_L_in</ci>
          </apply>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>w_v</ci>
            </apply>
            <ci>H_L_out</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>RBC_volume_R</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>w_v_d</ci>
            <ci>H_R_out</ci>
          </apply>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>w_v_d</ci>
            </apply>
            <ci>H_R_in</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>q_us</ci>
        <apply>
          <times/>
          <pi/>
          <apply>
            <power/>
            <ci>r</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
          <ci>l</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q</ci>
        <apply>
          <plus/>
          <ci>q_us</ci>
          <ci>q_C</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>C</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <pi/>
            <apply>
              <power/>
              <cn type="e-notation" cellml:units="metre">8.5<sep/>-9</cn>
              <cn cellml:units="dimensionless">2</cn>
            </apply>
            <ci>l</ci>
          </apply>
          <cn cellml:units="J_per_m3">133.322</cn>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>Z</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">0.8</cn>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">0.075</cn>
                  </apply>
                  <cn cellml:units="dimensionless">2</cn>
                  <ci>r</ci>
                  <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                </apply>
              </apply>
            </apply>
            <apply>
              <plus/>
              <apply>
                <minus/>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <divide/>
                <cn cellml:units="dimensionless">1</cn>
                <apply>
                  <plus/>
                  <cn cellml:units="dimensionless">1</cn>
                  <apply>
                    <times/>
                    <apply>
                      <power/>
                      <cn cellml:units="dimensionless">10</cn>
                      <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">11</cn>
                      </apply>
                    </apply>
                    <apply>
                      <power/>
                      <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2</cn>
                        <ci>r</ci>
                        <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                      </apply>
                      <cn cellml:units="dimensionless">12</cn>
                    </apply>
                  </apply>
                </apply>
              </apply>
            </apply>
          </apply>
          <apply>
            <divide/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <times/>
                <apply>
                  <power/>
                  <cn cellml:units="dimensionless">10</cn>
                  <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">11</cn>
                  </apply>
                </apply>
                <apply>
                  <power/>
                  <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r</ci>
                    <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                  </apply>
                  <cn cellml:units="dimensionless">12</cn>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>mu_45</ci>
        <apply>
          <minus/>
          <apply>
            <plus/>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">6</cn>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <apply>
                    <minus/>
                    <cn cellml:units="per_m">0.085</cn>
                  </apply>
                  <cn cellml:units="dimensionless">2</cn>
                  <ci>r</ci>
                  <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                </apply>
              </apply>
            </apply>
            <cn cellml:units="dimensionless">3.2</cn>
          </apply>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">2.44</cn>
            <apply>
              <exp/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <cn cellml:units="dimensionless">0.06</cn>
                </apply>
                <apply>
                  <power/>
                  <apply>
                    <times/>
                    <cn cellml:units="per_m">2</cn>
                    <ci>r</ci>
                    <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                  </apply>
                  <cn cellml:units="dimensionless">0.645</cn>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>mu</ci>
        <apply>
          <times/>
          <ci>hem_dep_u_rel</ci>
          <ci>mu_plasma</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>hem_dep_u_rel</ci>
        <apply>
          <plus/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <times/>
            <apply>
              <divide/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <ci>mu_45</ci>
                  <cn cellml:units="dimensionless">1</cn>
                </apply>
                <apply>
                  <minus/>
                  <apply>
                    <power/>
                    <apply>
                      <minus/>
                      <cn cellml:units="dimensionless">1</cn>
                      <ci>H_mean</ci>
                    </apply>
                    <ci>Z</ci>
                  </apply>
                  <cn cellml:units="dimensionless">1</cn>
                </apply>
              </apply>
              <apply>
                <minus/>
                <apply>
                  <power/>
                  <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>H_global_L</ci>
                  </apply>
                  <ci>Z</ci>
                </apply>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
            </apply>
            <apply>
              <power/>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <cn cellml:units="dimensionless">2</cn>
                  <ci>r</ci>
                  <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                </apply>
                <apply>
                  <minus/>
                  <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>r</ci>
                    <cn type="e-notation" cellml:units="dimensionless">1<sep/>6</cn>
                  </apply>
                  <cn cellml:units="metre">1.1</cn>
                </apply>
              </apply>
              <cn cellml:units="dimensionless">2</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>R</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">8</cn>
            <ci>mu</ci>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <pi/>
            <apply>
              <power/>
              <ci>r</ci>
              <cn cellml:units="dimensionless">4</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>v_mm3_s</ci>
        <apply>
          <divide/>
          <ci>v</ci>
          <ci>one_mm3</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>u_in</ci>
            <ci>u</ci>
          </apply>
          <apply>
            <divide/>
            <ci>R</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>u_mmHg</ci>
        <apply>
          <divide/>
          <ci>u</ci>
          <cn cellml:units="J_per_m3">133.322</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <ci>q_C</ci>
            <ci>C</ci>
          </apply>
          <ci>u_ext</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
