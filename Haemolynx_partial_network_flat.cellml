    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>q_us</ci>
        <apply>
          <times/>
          <pi/>
          <apply>
            <power/>
            <ci>r</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
          <ci>l</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q</ci>
        <apply>
          <plus/>
          <ci>q_us</ci>
          <ci>q_C</ci>
          <ci>q_C_d</ci>
        </apply>
