        <ci>vbc2</ci>
      </apply>
      <apply>
        <eq/>
        <ci>vj3</ci>
        <apply>
          <minus/>
          <ci>vbc3</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>vj4</ci>
        <apply>
          <minus/>
          <ci>vbc4</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>H_split1</ci>
        <piecewise>
          <piece>
            <ci>H_VV_out_alpha</ci>
            <apply>
              <eq/>
              <ci>alpha1</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>H_VV_out_beta</ci>
            <apply>
              <eq/>
              <ci>beta1</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>H_to1</ci>
          </otherwise>
        </piecewise>
      </apply>
      <!-- not a split-daughter =>unchanged-->
      <apply>
        <eq/>
        <ci>H_split2</ci>
        <piecewise>
          <piece>
            <ci>H_VV_out_alpha</ci>
            <apply>
              <eq/>
