        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>D1</ci>
        <apply>
          <times/>
          <cn cellml:units="dimensionless">2</cn>
          <ci>r_bc1</ci>
        </apply>
      </apply>
      <!--<&#45;&#45; port1 attached vessel diameter (example: parent VV side)-->
      <apply>
        <eq/>
        <ci>D2</ci>
        <apply>
          <times/>
          <cn cellml:units="dimensionless">2</cn>
          <ci>r_bc2</ci>
        </apply>
      </apply>
      <!--<&#45;&#45; port2 (if unused, still define)-->
      <apply>
        <eq/>
        <ci>D3</ci>
        <apply>
          <times/>
          <cn cellml:units="dimensionless">2</cn>
          <ci>r_bc3</ci>
        </apply>
      </apply>
      <!--<&#45;&#45; port3 daughter candidate-->
      <apply>
        <eq/>
        <ci>D4</ci>
        <apply>
          <times/>
          <cn cellml:units="dimensionless">2</cn>
          <ci>r_bc4</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>w_in1</ci>
        <apply>
          <plus/>
          <cn cellml:units="dimensionless">0.5</cn>
          <apply>
            <times/>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">1</cn>
              <pi/>
            </apply>
            <apply>
              <arctan/>
              <apply>
                <divide/>
                <ci>vj1</ci>
                <ci>v_scale</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>w_in2</ci>
        <apply>
          <plus/>
          <cn cellml:units="dimensionless">0.5</cn>
          <apply>
