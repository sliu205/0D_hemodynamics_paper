              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>Qout4</ci>
            <apply>
              <eq/>
              <ci>alpha4</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
