            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <power/>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <ci>f_crit</ci>
                  <apply>
                    <abs/>
                    <ci>v</ci>
                  </apply>
                </apply>
                <ci>BOSF_Bx</ci>
              </apply>
              <ci>n</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <!--low_q              = 1{dimensionless}/(1{dimensionless}+pow(f_crit*abs(v)/v_base, n));-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>K_deprived</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
