          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Qout4</ci>
        <apply>
          <times/>
          <ci>w_out4</ci>
          <apply>
            <minus/>
            <ci>vj4</ci>
          </apply>
        </apply>
      </apply>
