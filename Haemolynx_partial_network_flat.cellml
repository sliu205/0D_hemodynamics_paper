    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>w_out1</ci>
        <apply>
          <minus/>
          <cn cellml:units="dimensionless">1</cn>
          <ci>w_in1</ci>
        </apply>
      </apply>
      <!-- ~1 if vj1<0-->
      <apply>
        <eq/>
        <ci>w_out2</ci>
        <apply>
          <minus/>
          <cn cellml:units="dimensionless">1</cn>
          <ci>w_in2</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>w_out3</ci>
        <apply>
          <minus/>
          <cn cellml:units="dimensionless">1</cn>
