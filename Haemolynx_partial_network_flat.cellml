              <apply>
                <eq/>
                <ci>is_split</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <eq/>
                <ci>bc3_is_out</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <eq/>
                <ci>alpha3</ci>
                <cn cellml:units="dimensionless">0</cn>
              </apply>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>beta4</ci>
        <piecewise>
          <piece>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <and/>
              <apply>
                <eq/>
                <ci>is_split</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <eq/>
                <ci>bc4_is_out</ci>
                <cn cellml:units="dimensionless">1</cn>
              </apply>
              <apply>
                <eq/>
                <ci>alpha4</ci>
                <cn cellml:units="dimensionless">0</cn>
              </apply>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0</cn>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>D_F</ci>
        <piecewise>
          <piece>
            <ci>D1</ci>
            <apply>
              <eq/>
              <ci>feed1</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>D2</ci>
            <apply>
              <eq/>
              <ci>feed2</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>D3</ci>
            <apply>
              <eq/>
              <ci>feed3</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <piece>
            <ci>D4</ci>
            <apply>
              <eq/>
              <ci>feed4</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>D1</ci>
          </otherwise>
        </piecewise>
